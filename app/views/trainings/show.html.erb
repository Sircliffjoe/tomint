<% content_for :title, @training.title %>

<div class="bg-white px-6 <%= (user_signed_in? && admin_area?) ? 'py-8' : 'py-32' %> lg:px-8">
  <div class="mx-auto max-w-3xl text-base leading-7 text-gray-700">
    <div class="mb-8">
      <%= link_to "Back to Training", trainings_path, class: "text-sm font-semibold leading-6 text-green-600 hover:text-green-500" %>
    </div>
    
    <p class="text-base font-semibold leading-7 text-green-600"><%= @training.category %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= @training.title %></h1>
    
    <div class="mt-6 prose prose-lg text-gray-500">
      <%= @training.description %>
    </div>

    <div class="mt-10 rounded-2xl border border-green-100 bg-green-50 p-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900">Register for this training</h2>
      <p class="mt-2 text-sm text-gray-600">You can register as a guest. No account is required.</p>

      <%= form_with model: [@training, @training_registration], url: training_training_registrations_path(@training), class: "mt-5 grid gap-4" do |form| %>
        <% if @training_registration.errors.any? %>
          <div class="rounded-lg bg-red-50 p-3 text-sm text-red-700">
            <%= @training_registration.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <%= form.text_field :guest_name, placeholder: "Full name", class: "tom-input", aria: { label: "Full name" } %>
        <%= form.email_field :guest_email, placeholder: "Email address", class: "tom-input", aria: { label: "Email address" } %>
        <%= form.telephone_field :guest_phone, placeholder: "Phone number", class: "tom-input", aria: { label: "Phone number" } %>
        <%= form.submit "Register for Training", class: "tom-btn tom-btn-primary", style: "border:0;cursor:pointer;" %>
      <% end %>
    </div>

    <h2 class="mt-16 text-2xl font-bold tracking-tight text-gray-900">Modules</h2>
    <div class="mt-6 bg-white shadow overflow-hidden sm:rounded-md">
      <ul role="list" class="divide-y divide-gray-200">
        <% @training.training_sessions.each_with_index do |session, index| %>
          <li>
            <%= link_to training_training_session_path(@training, session), class: "block hover:bg-gray-50" do %>
              <div class="px-4 py-4 sm:px-6">
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <span class="flex-shrink-0 h-10 w-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold">
                      <%= index + 1 %>
                    </span>
                    <p class="ml-4 text-sm font-medium text-green-600 truncate"><%= session.title %></p>
                  </div>
                  <div class="flex-shrink-0">
                    <p class="text-sm text-gray-500"><%= session.duration %> mins</p>
                  </div>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
