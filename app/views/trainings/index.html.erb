<% content_for :title, "Training Resources" %>

<section class="tom-page-hero">
  <div class="tom-container">
    <div class="tom-page-panel" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Training</span>
      <h1>Training Resources</h1>
      <p style="margin-top:1rem;line-height:1.75;">Equipping the next generation of leaders with biblical knowledge and practical skills.</p>
    </div>
  </div>
</section>

<section class="tom-feature-band">
  <div class="tom-container tom-feature-split">
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow">Programme Overview</span>
      <h2>No one can do well, what he or she has not been trained to do.</h2>
      <p>TOM lays a lot of emphasis on training. We equip workers and leaders through sessions, media, and guided programme pathways.</p>
    </div>
    <div class="tom-media" data-reveal>
      <%= image_tag "Slider-new4.png", alt: "Training and discipleship session", loading: "lazy" %>
    </div>
  </div>
</section>

<section class="tom-section">
  <div class="tom-container">
    <div class="tom-info-grid">
      <% [
        ["Biblical foundation", "Christ-centred learning for workers and teenagers.", "var(--tom-teal)"],
        ["Practical skills", "Tools for mentoring, outreach, and leadership.", "var(--tom-orange)"],
        ["LMS-lite", "Sessions, media, and guided programme pathways.", "var(--tom-purple)"]
      ].each do |title, text, accent| %>
        <article class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal>
          <small>Training Highlight</small>
          <h3><%= title %></h3>
          <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;"><%= text %></p>
        </article>
      <% end %>
    </div>

    <% category_art = {
      "Leadership" => ["Slider-new3.png", "TOM-Kwali-Bible-Reading4-scaled-1.jpg", "Worker formation for leaders serving teenagers with clarity, humility, and conviction."],
      "Outreach" => ["WhatsApp-Image-2025-04-26-at-3.23.07-AM.jpeg", "WhatsApp-Image-2025-04-26-at-3.22.54-AM.jpeg", "Practical preparation for gospel engagement in schools, clubs, camps, and neighbourhoods."],
      "Discipleship" => ["Slider-new4.png", "WhatsApp-Image-2025-04-26-at-3.23.18-AM.jpeg", "Training pathways that help workers guide teenagers into mature Christian faith."],
      "Training" => ["TOM-Kwali-Bible-Reading4-scaled-1.jpg", "WhatsApp-Image-2025-04-26-at-3.22.56-AM.jpeg", "Equipping workers, parents, teachers, and youth leaders for effective teenagers' ministry."]
    } %>

    <% @trainings_by_category.each do |category, trainings| %>
      <% art = category_art.fetch(category.to_s, ["Slider-new4.png", "TOM-Kwali-Bible-Reading4-scaled-1.jpg", "Guided course pathways for workers and leaders serving teenagers."]) %>
      <div class="tom-training-category-row" style="--accent:<%= ["var(--tom-teal)", "var(--tom-yellow)", "var(--tom-orange)", "var(--tom-purple)"][@trainings_by_category.keys.index(category) % 4] %>;">
        <div class="tom-section-title" data-reveal>
          <div>
            <span class="tom-eyebrow"><%= category %></span>
            <h2>Certificate Course Cards</h2>
          </div>
        </div>
        <div class="tom-training-category-layout">
          <div class="tom-training-card-stack">
            <% trainings.each_with_index do |training, index| %>
              <% accent = ["var(--tom-teal)", "var(--tom-yellow)", "var(--tom-orange)", "var(--tom-purple)"][index % 4] %>
              <article class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal>
                <small><%= pluralize(training.training_sessions.count, "Session") %></small>
                <h3><%= link_to training.title, training_path(training) %></h3>
                <% if training.description.present? %>
                  <div style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= training.description %></div>
                <% else %>
                  <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;">Expandable topics and session media are available inside the course.</p>
                <% end %>
                <%= link_to "Enrol", training_path(training), class: "tom-btn tom-btn-primary", style: "margin-top:1rem;" %>
              </article>
            <% end %>
          </div>

          <aside class="tom-training-category-art" data-reveal>
            <div class="tom-training-category-images">
              <%= image_tag art[0], alt: "#{category} training moment", loading: "lazy" %>
              <%= image_tag art[1], alt: "#{category} training session", loading: "lazy" %>
            </div>
            <div class="tom-training-category-note">
              <span><%= category %> Pathway</span>
              <p><%= art[2] %></p>
            </div>
          </aside>
        </div>
      </div>
          <% end %>
  </div>
</section>

<section class="tom-band" style="padding-block:4rem;">
  <div class="tom-container tom-feature-split">
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Graduate Quote</span>
      <h2 style="color:white;">Training that helps workers reach and mentor teenagers.</h2>
      <p style="color:rgba(255,255,255,.85);">"Being part of TOM has given me the tools and training to effectively reach and mentor teenagers in my community."</p>
      <p style="color:white;font-weight:800;">Sis. Amaka</p>
    </div>
    <div class="tom-card" style="padding:1.5rem;" data-reveal>
      <h3>Trainer Profiles</h3>
      <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.6;">Compact profile cards for facilitators, subject areas, and session ownership can be managed as the training module grows.</p>
    </div>
  </div>
</section>

<section class="tom-section bg-white" style="text-align:center;">
  <div class="tom-container" data-reveal>
    <h2>Ready to be equipped?</h2>
    <p style="max-width:620px;margin:1rem auto 0;color:var(--tom-muted);">Choose a training path and start building capacity for teen ministry.</p>
    <%= link_to "View Training", trainings_path, class: "tom-btn tom-btn-primary", style: "margin-top:1.25rem;" %>
  </div>
</section>
