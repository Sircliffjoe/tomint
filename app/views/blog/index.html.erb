<% content_for :title, "Blog & News" %>

<section class="tom-page-hero">
  <div class="tom-container">
    <div class="tom-page-panel" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Blog</span>
      <h1>Latest News & Updates</h1>
      <p style="margin-top:1rem;line-height:1.75;">Stories of impact, upcoming events, and ministry updates.</p>
    </div>
  </div>
</section>

<section class="tom-section bg-white" data-filter-group data-default-filter="all">
  <div class="tom-container">
    <div class="tom-filter-row" role="tablist" aria-label="Blog filters" data-reveal>
      <% [["all", "All"], ["devotionals", "Devotionals"], ["news", "News"], ["events", "Events"], ["tips", "Tips"], ["stories", "Stories"]].each do |key, label| %>
        <button type="button" class="tom-btn" data-filter-button="<%= key %>" role="tab"><%= label %></button>
      <% end %>
    </div>

    <% featured = @posts.first %>
    <% if featured %>
      <%= link_to blog_path(featured), class: "tom-card", style: "display:block;overflow:hidden;margin-top:2rem;text-decoration:none;", data: { reveal: true } do %>
        <div class="tom-feature-split" style="gap:0;">
          <div class="tom-media" style="border-radius:0;box-shadow:none;">
            <%= image_tag "WhatsApp-Image-2025-04-26-at-3.23.15-AM-2.jpeg", alt: featured.title, loading: "lazy" %>
          </div>
          <div style="padding:2rem;">
            <span class="tom-eyebrow">Featured Post</span>
            <h2 style="margin-top:.7rem;color:var(--tom-ink);"><%= featured.title %></h2>
            <p style="margin-top:.8rem;color:var(--tom-muted);"><%= featured.published_at.strftime("%B %d, %Y") %> • <%= featured.author.first_name %> <%= featured.author.last_name %></p>
            <p style="margin-top:1rem;color:var(--tom-muted);line-height:1.65;"><%= featured.body.to_plain_text.truncate(240) %></p>
            <span class="tom-btn tom-btn-primary" style="margin-top:1.25rem;">Read More</span>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="tom-section-title" style="margin-top:3rem;" data-reveal>
      <div>
        <span class="tom-eyebrow">From Our Blog</span>
        <h2>Recent articles</h2>
      </div>
    </div>

    <div class="tom-blog-layout">
      <div class="tom-blog-post-grid">
        <% @posts.each_with_index do |post, index| %>
          <% post_text = "#{post.title} #{post.body.to_plain_text}".downcase %>
          <% category =
            if post_text.match?(/devotional|scripture|faith|prayer|bible|christ/)
              "devotionals"
            elsif post_text.match?(/event|camp|conference|registration/)
              "events"
            elsif post_text.match?(/tip|guide|how to|help|mentor/)
              "tips"
            elsif post_text.match?(/story|testimony|impact/)
              "stories"
            else
              ["news", "events", "tips", "stories", "devotionals"][index % 5]
            end %>
          <% accent = ["var(--tom-teal)", "var(--tom-yellow)", "var(--tom-orange)", "var(--tom-purple)"][index % 4] %>
          <article class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal data-filter-item="<%= category %>">
            <small><%= category.titleize %> • <%= pluralize((post.body.to_plain_text.split.size / 200.0).ceil.clamp(1, 12), "min") %> read</small>
            <h3><%= link_to post.title, blog_path(post) %></h3>
            <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= post.body.to_plain_text.truncate(150) %></p>
            <p style="margin-top:1rem;color:var(--tom-muted);font-size:.85rem;"><%= post.author.first_name %> <%= post.author.last_name %></p>
          </article>
        <% end %>
        <div class="tom-filter-empty" style="grid-column:1/-1;" data-filter-empty hidden>No posts found for this filter yet.</div>
      </div>
      <aside class="tom-blog-sidebar">
        <div class="tom-card" style="padding:1.25rem;" data-reveal>
          <h3>Recent Posts</h3>
          <div style="display:grid;gap:.8rem;margin-top:1rem;">
            <% @posts.limit(4).each do |post| %>
              <%= link_to post.title, blog_path(post), style: "color:var(--tom-ink);font-weight:800;text-decoration:none;" %>
            <% end %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
