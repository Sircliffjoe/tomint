<% content_for :title, "Support Our Mission" %>

<section class="tom-page-hero">
  <div class="tom-container">
    <div class="tom-page-panel" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Donate</span>
      <h1>Your Gift Changes a Life</h1>
      <p style="margin-top:1rem;line-height:1.75;">Your generosity helps us reach more teenagers with the gospel and raise effective leaders.</p>
    </div>
  </div>
</section>

<section class="tom-section bg-white">
  <div class="tom-container tom-feature-split" style="align-items:start;">
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow">Opportunity To Give</span>
      <h2>Partner with TOM to reach the rising generation.</h2>
      <p>Your giving supports outreaches, teen clubs, trainings, camps, and discipleship follow-up across communities.</p>
      <div class="tom-donation-image-card" data-reveal>
        <%= image_tag "donation-giving-cause.png", alt: "Hands giving toward a community cause", loading: "lazy" %>
      </div>
    </div>

    <div class="tom-card" style="padding:1.5rem;" data-reveal>
      <h2>Give Now</h2>
      <p style="margin-top:.6rem;color:var(--tom-muted);line-height:1.6;">Enter your amount and choose what you are giving toward.</p>

      <%= form_with(model: @donation, style: "display:grid;gap:1rem;margin-top:1.3rem;") do |f| %>
        <% if @donation.errors.any? %>
          <div style="border-radius:8px;background:#fff1f1;padding:1rem;color:#b42318;">
            <h3>There were errors with your submission</h3>
            <ul style="margin-top:.5rem;padding-left:1rem;">
              <% @donation.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= hidden_field_tag :form_started_at, @donation_form_started_at %>
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <%= label_tag :website, "Website" %>
          <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
        </div>

        <div>
          <%= f.label :amount, "Amount (NGN)", style: "display:block;font-weight:800;margin-bottom:.45rem;" %>
          <%= f.number_field :amount, step: "100", class: "tom-input", placeholder: "5000" %>
        </div>

        <div>
          <%= f.label :donor_email, "Email Address", style: "display:block;font-weight:800;margin-bottom:.45rem;margin-top:.50rem;" %>
          <%= f.email_field :donor_email, class: "tom-input", placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :purpose, "Giving Category", style: "display:block;font-weight:800;margin-bottom:.45rem;margin-top:.50rem;" %>
          <%= f.select :purpose, ["General Support", "Outreach", "Teenagers' Clubs", "Training", "Camp Sponsorship", "Event Giving", "Programme Support", "Projects"], {}, class: "tom-input" %>
        </div>

        <%= f.submit "Donate Now", class: "tom-btn tom-btn-primary", style: "width:100%;border:0;cursor:pointer;margin-top:.80rem;" %>
      <% end %>

      <div style="margin-top:1.5rem;border-radius:8px;background:#f1faf5;padding:1rem;">
        <h3>Bank Details</h3>
        <p style="margin-top:.65rem;color:var(--tom-muted);line-height:1.65;">Account Name: Teenagers' Outreach Ministries<br>Bank: First Bank<br>Account Number: 2006864196</p>
        <button type="button" class="tom-btn tom-btn-light" style="margin-top:.8rem;border:0;" data-copy-text="2006864196">Copy Account Number</button>
      </div>
      <div style="margin-top:1.5rem;border-radius:8px;background:#f1faf5;padding:1rem;">
        <p style="margin-top:.65rem;color:var(--tom-muted);line-height:1.65;">Account Name: Teenagers' Outreach Ministries<br>Bank: First Bank<br>Account Number: 2008599317</p>
        <button type="button" class="tom-btn tom-btn-light" style="margin-top:.8rem;border:0;" data-copy-text="2008599317">Copy Account Number</button>
      </div>
      <div style="margin-top:1.5rem;border-radius:8px;background:#f1faf5;padding:1rem;">
        <p style="font-weight:800;">Building Project</p>
        <p style="margin-top:.65rem;color:var(--tom-muted);line-height:1.65;">Account Name: Teenagers' Outreach Ministries<br>Bank: Zenith Bank<br>Account Number: 1016869906</p>
        <button type="button" class="tom-btn tom-btn-light" style="margin-top:.8rem;border:0;" data-copy-text="1016869906">Copy Account Number</button>
      </div>
    </div>
  </div>
</section>

<section class="tom-band" style="padding-block:4rem;">
  <div class="tom-container">
    <div class="tom-info-grid">
      <% [
        ["Transparency", "Clear purpose-based giving."],
        ["Impact", "Every gift supports teenagers and workers."],
        ["Accountability", "Donation records and receipts are part of the platform vision."]
      ].each do |title, text| %>
        <div class="tom-card" style="padding:1.4rem;" data-reveal>
          <h3><%= title %></h3>
          <p style="margin-top:.7rem;color:var(--tom-muted);line-height:1.6;"><%= text %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
