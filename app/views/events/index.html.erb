<% content_for :title, "Upcoming Events" %>

<section class="tom-page-hero">
  <div class="tom-container">
    <div class="tom-page-panel" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Events</span>
      <h1>Upcoming Events</h1>
      <p style="margin-top:1rem;line-height:1.75;">Join us for our upcoming outreaches, training sessions, and conferences.</p>
    </div>
  </div>
</section>

<section class="tom-section bg-white" data-filter-group data-default-filter="all">
  <div class="tom-container">
    <div class="tom-filter-row" role="tablist" aria-label="Event filters" data-reveal>
      <% [["all", "All"], ["upcoming", "Upcoming"], ["camp", "Camps"], ["training", "Training"], ["past", "Past"]].each do |key, label| %>
        <button type="button" class="tom-btn" data-filter-button="<%= key %>" role="tab"><%= label %></button>
      <% end %>
    </div>

    <% spotlight = @events.first %>
    <% if spotlight %>
      <%= link_to event_path(spotlight), class: "tom-card", style: "display:block;overflow:hidden;margin-top:2rem;text-decoration:none;", data: { reveal: true, filter_item: "all upcoming spotlight" } do %>
        <div class="tom-feature-split" style="gap:0;">
          <div class="tom-media" style="border-radius:0;box-shadow:none;">
            <% if spotlight.image.attached? %>
              <%= image_tag spotlight.image, alt: spotlight.title, loading: "lazy" %>
            <% else %>
              <%= image_tag "/outreach.png", alt: spotlight.title, loading: "lazy" %>
            <% end %>
          </div>
          <div style="padding:2rem;">
            <span class="tom-eyebrow">Spotlight Event</span>
            <h2 style="margin-top:.7rem;color:var(--tom-ink);"><%= spotlight.title %></h2>
            <p style="margin-top:1rem;color:var(--tom-muted);"><%= spotlight.start_time.strftime("%B %d, %Y") %> <%= spotlight.location.present? ? "• #{spotlight.location}" : "" %></p>
            <div style="margin-top:1rem;color:var(--tom-muted);line-height:1.65;"><%= spotlight.description %></div>
            <span class="tom-btn tom-btn-primary" style="margin-top:1.25rem;">Register</span>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="tom-section-title" style="margin-top:3rem;" data-reveal>
      <div>
        <span class="tom-eyebrow">Events Grid</span>
        <h2>Ministry gatherings</h2>
      </div>
    </div>

    <div class="tom-three-grid">
      <% [ [@events, "upcoming"], [@past_events, "past"] ].each do |collection, status| %>
        <% collection.each_with_index do |event, index| %>
          <% plain_description = event.description.to_plain_text rescue "" %>
          <% corpus = "#{event.title} #{plain_description}".downcase %>
          <% tags = [status] %>
          <% tags << "camp" if corpus.include?("camp") %>
          <% tags << "training" if corpus.include?("training") || corpus.include?("course") || corpus.include?("workshop") %>
          <% accent = ["var(--tom-teal)", "var(--tom-orange)", "var(--tom-yellow)", "var(--tom-purple)"][index % 4] %>
          <article class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal data-filter-item="<%= tags.join(' ') %>">
            <small><%= event.start_time.strftime("%b %d, %Y") %> • <%= status.titleize %></small>
            <h3><%= link_to event.title, event_path(event) %></h3>
            <div style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= event.description %></div>
            <p style="margin-top:.8rem;color:var(--tom-muted);font-size:.9rem;"><%= event.location.presence || event.state&.name || "Location TBA" %></p>
            <%= link_to "Register", event_path(event), class: "tom-btn tom-btn-primary", style: "margin-top:1rem;" %>
          </article>
        <% end %>
      <% end %>
    </div>

    <div class="tom-filter-empty" data-filter-empty hidden>No events found for this filter yet.</div>
  </div>
</section>
