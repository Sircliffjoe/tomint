<% content_for :title, "Upcoming Events" %>

<section class="tom-page-hero">
  <div class="tom-container">
    <div class="tom-page-panel" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Events</span>
      <h1>Upcoming Events</h1>
      <p style="margin-top:1rem;line-height:1.75;">Join us for our upcoming outreaches, training sessions, and conferences.</p>
    </div>
  </div>
</section>

<section class="tom-section bg-white">
  <div class="tom-container">
    <% if @spotlight_event %>
      <% spotlight_summary = @spotlight_event.description.to_plain_text.squish.truncate(220) rescue strip_tags(@spotlight_event.description.to_s).squish.truncate(220) %>
      <%= link_to event_path(@spotlight_event), class: "tom-card", style: "display:block;overflow:hidden;margin-bottom:2rem;text-decoration:none;", data: { reveal: true } do %>
        <div class="tom-feature-split" style="gap:0;align-items:stretch;">
          <div class="tom-media" style="border-radius:0;box-shadow:none;min-height:280px;">
            <% if @spotlight_event.image.attached? %>
              <%= image_tag @spotlight_event.image, alt: @spotlight_event.title, loading: "lazy" %>
            <% else %>
              <%= image_tag "/outreach.png", alt: @spotlight_event.title, loading: "lazy" %>
            <% end %>
          </div>
          <div style="padding:2rem;display:flex;flex-direction:column;justify-content:center;">
            <span class="tom-eyebrow">Spotlight Event</span>
            <h2 style="margin-top:.7rem;color:var(--tom-ink);"><%= @spotlight_event.title %></h2>
            <p style="margin-top:1rem;color:var(--tom-muted);"><%= @spotlight_event.date_label %> <%= @spotlight_event.location.present? ? "• #{@spotlight_event.location}" : "" %></p>
            <p style="margin-top:1rem;color:var(--tom-muted);line-height:1.65;"><%= spotlight_summary %></p>
            <span class="tom-btn tom-btn-primary" style="margin-top:1.25rem;"><%= @spotlight_event.information_only? ? "Learn More" : "View Details" %></span>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="tom-section-title" style="margin-top:3rem;" data-reveal>
      <div>
        <span class="tom-eyebrow">Events Grid</span>
        <h2>Explore TOM Events</h2>
      </div>
    </div>

    <div class="tom-three-grid">
      <% @events.each_with_index do |event, index| %>
        <% plain_description = event.description.to_plain_text rescue "" %>
        <% accent = ["var(--tom-teal)", "var(--tom-orange)", "var(--tom-yellow)", "var(--tom-purple)"][index % 4] %>
        <% status = event.start_time.blank? || event.start_time >= Time.current ? "Upcoming" : "Past" %>
      
        
        <article class="tom-resource-card tom-event-card" style="--accent:<%= accent %>;" data-reveal>
          <div class="tom-event-card__body">
            <% if event.image.attached? %>
              <%= image_tag event.image, alt: event.title, loading: "lazy", style: "width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" %>
            <% end %>
            <small><%= event.date_label %> • <%= status %></small>
            <h3><%= link_to event.title, event_path(event) %></h3>
            <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= plain_description.squish.truncate(150) %></p>
            <p style="margin-top:.8rem;color:var(--tom-muted);font-size:.9rem;"><%= event.location_label %></p>
            <%= link_to(event.information_only? ? "Learn More" : "View Details", event_path(event), class: "tom-btn tom-btn-primary", style: "margin-top:1rem;") %>
          </div>
        </article>
      <% end %>
    </div>

    <div style="margin-top: 3rem; display: flex; justify-content: center;">
      <%== @pagy.series_nav %>
    </div>
  </div>
</section>
