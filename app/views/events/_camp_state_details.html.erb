<% active_countries = Country.active.includes(states: [ :country, :areas ]).ordered %>
<% camp_detail_state_refs = CampDetail.state_reference_available? %>
<% details_by_state_id = camp_detail_state_refs ? camp_details.select(&:state_id).group_by(&:state_id) : {} %>
<% legacy_details_by_state = camp_detail_state_refs ? camp_details.reject(&:state_id).group_by(&:state_name) : camp_details.group_by(&:state_name) %>

<section class="tom-camp-details" data-camp-details>
  <div class="tom-camp-details__heading">
    <span class="tom-eyebrow">Camp Details</span>
    <h2>Choose Your Location</h2>
  </div>

  <% active_countries_with_states = active_countries.select { |country| country.states.active.exists? } %>
  <% legacy_only_names = legacy_details_by_state.keys - active_countries.flat_map { |country| country.states.map(&:name) } %>

  <% if active_countries_with_states.empty? && legacy_only_names.empty? %>
    <div class="tom-camp-empty">
      Camp location details will be updated soon.
    </div>
  <% else %>
    <div class="tom-camp-location-tabs" role="tablist">
      <% active_countries_with_states.each_with_index do |country, index| %>
        <button type="button" class="tom-camp-location-tab <%= 'is-active' if index == 0 %>" role="tab" data-target="tom-camp-panel-<%= country.id %>">
          <%= country.name %>
        </button>
      <% end %>
      <% if legacy_only_names.any? %>
        <button type="button" class="tom-camp-location-tab <%= 'is-active' if active_countries_with_states.empty? %>" role="tab" data-target="tom-camp-panel-other">
          Other Locations
        </button>
      <% end %>
    </div>

    <div class="tom-camp-location-panels">
      <% active_countries_with_states.each_with_index do |country, index| %>
        <div class="tom-camp-location-panel <%= 'is-active' if index == 0 %>" id="tom-camp-panel-<%= country.id %>" role="tabpanel">
          <div class="tom-camp-grid" role="list" aria-label="TOM Camp locations in <%= country.name %>">
            <% country.states.active.ordered.each do |state_record| %>
              <% state_details = (((camp_detail_state_refs ? details_by_state_id[state_record.id] : []) || []) + (legacy_details_by_state[state_record.name] || [])).select(&:public_content?) %>
              <% locations = state_details.map do |detail|
                {
                  area: detail.area_label,
                  notesHtml: detail.public_notes_html,
                  registrationLink: detail.registration_link,
                  flyerImage: detail.flyer.attached? ? url_for(detail.flyer) : nil
                }
              end %>
              <% state_payload = {
                state: state_record.name,
                country: country.name,
                locations: locations
              } %>
              <button
                type="button"
                class="tom-camp-state"
                role="listitem"
                data-camp-state="<%= json_escape(state_payload.to_json) %>">
                <%= state_record.name %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if legacy_only_names.any? %>
        <div class="tom-camp-location-panel <%= 'is-active' if active_countries_with_states.empty? %>" id="tom-camp-panel-other" role="tabpanel">
          <div class="tom-camp-grid" role="list" aria-label="Other TOM Camp locations">
            <% legacy_only_names.sort.each do |state_name| %>
              <% state_details = (legacy_details_by_state[state_name] || []).select(&:public_content?) %>
              <% locations = state_details.map do |detail|
                {
                  area: detail.area_label,
                  notesHtml: detail.public_notes_html,
                  registrationLink: detail.registration_link,
                  flyerImage: detail.flyer.attached? ? url_for(detail.flyer) : nil
                }
              end %>
              <% state_payload = { state: state_name, locations: locations } %>
              <button type="button" class="tom-camp-state" role="listitem" data-camp-state="<%= json_escape(state_payload.to_json) %>">
                <%= state_name %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <dialog class="tom-camp-modal" data-camp-modal aria-labelledby="camp-modal-title">
    <button type="button" class="tom-camp-modal__close" data-camp-modal-close aria-label="Close camp details">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4 17.6 5 12 10.6 6.4 5z"/></svg>
    </button>

    <div class="tom-camp-modal__media">
      <img data-camp-modal-image alt="" hidden>
      <div class="tom-camp-modal__placeholder" data-camp-modal-placeholder>
        <span>TOM Camp</span>
      </div>
    </div>

    <div class="tom-camp-modal__body">
      <span class="tom-eyebrow">Camp Information</span>
      <h3 id="camp-modal-title" data-camp-modal-state></h3>

      <div class="tom-camp-modal__notes trix-content" data-camp-modal-notes></div>

      <a class="tom-camp-modal__link" data-camp-modal-link target="_blank" rel="noopener" hidden>
        Register
      </a>

      <div class="tom-camp-modal__switcher" data-camp-modal-switcher hidden>
        <div class="tom-camp-modal__pager">
          <button type="button" data-camp-modal-prev aria-label="Previous camp area">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.7 5.3 14.3 4 6.3 12l8 8 1.4-1.3L9 12z"/></svg>
          </button>
          <span data-camp-modal-count></span>
          <button type="button" data-camp-modal-next aria-label="Next camp area">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.3 18.7 1.4 1.3 8-8-8-8-1.4 1.3L15 12z"/></svg>
          </button>
        </div>

        <div class="tom-camp-modal__areas" data-camp-modal-areas></div>
      </div>
    </div>
  </dialog>
</section>

<style>
  .tom-camp-location-tabs {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    border-bottom: 2px solid rgba(20, 83, 45, 0.1);
    padding-bottom: 1rem;
  }
  .tom-camp-location-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(20, 83, 45, 0.12);
    border-radius: 8px;
    padding: 0.65rem 1.2rem;
    color: var(--tom-green-950, #052e16);
    background: #fff;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 180ms ease;
  }
  .tom-camp-location-tab:hover {
    border-color: rgba(22, 163, 74, 0.45);
    color: var(--tom-green-700, #15803d);
    transform: translateY(-1px);
  }
  .tom-camp-location-tab.is-active {
    color: #fff;
    background: var(--tom-green-700, #15803d);
    border-color: var(--tom-green-700, #15803d);
    box-shadow: 0 10px 24px rgba(22, 163, 74, 0.2);
  }
  .tom-camp-location-panel {
    display: none;
    animation: fadeIn 300ms ease-in-out;
  }
  .tom-camp-location-panel.is-active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  (function() {
    function initCampTabs() {
      const container = document.querySelector('.tom-camp-details');
      if (!container || container.dataset.publicTabsInitialized) return;
      container.dataset.publicTabsInitialized = "true";

      const tabs = container.querySelectorAll('.tom-camp-location-tab');
      const panels = container.querySelectorAll('.tom-camp-location-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('is-active'));
          panels.forEach(p => p.classList.remove('is-active'));

          tab.classList.add('is-active');

          const targetId = tab.getAttribute('data-target');
          const targetPanel = document.getElementById(targetId);
          if (targetPanel) {
            targetPanel.classList.add('is-active');
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCampTabs);
    } else {
      initCampTabs();
    }
    document.addEventListener("turbo:load", initCampTabs);
    document.addEventListener("turbo:render", initCampTabs);
  })();
</script>
