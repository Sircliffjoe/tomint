<%# Mobile Bottom Navigation Bar (Native App Style) %>
<%
  is_home = current_page?(root_path) rescue false
  is_qa = (request.path == ask_questions_path || request.path.start_with?('/ask/questions')) rescue false
  is_ask = (request.path == ask_root_path && !request.path.start_with?('/ask/questions')) rescue false
  is_events = (request.path == events_path || request.path.start_with?('/events') || request.path.start_with?('/ask/live')) rescue false
%>

<nav id="tom-mobile-bottom-nav" class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-[#042411]/95 backdrop-blur-2xl border-t border-emerald-500/25 shadow-[0_-8px_30px_rgba(0,0,0,0.45)] px-2 pt-1 pb-[calc(env(safe-area-inset-bottom,0px)+0.35rem)] select-none transition-all duration-300" aria-label="Mobile Bottom Navigation">
  <div class="max-w-md mx-auto grid grid-cols-5 items-end justify-items-center relative">
    
    <!-- 1. Home Tab -->
    <%= link_to root_path, class: "flex flex-col items-center justify-center py-1 px-2 w-full text-center transition-all duration-200 group active:scale-95 #{is_home ? 'text-lime-300 font-bold' : 'text-emerald-200/70 hover:text-white'}" do %>
      <div class="relative flex items-center justify-center">
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" fill="<%= is_home ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" stroke-width="<%= is_home ? '1.5' : '2' %>">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
      </div>
      <span class="text-[10px] mt-1 tracking-tight leading-tight">Home</span>
      <% if is_home %>
        <span class="w-1 h-1 rounded-full bg-lime-400 mt-0.5 shadow-[0_0_6px_#a3e635]"></span>
      <% else %>
        <span class="w-1 h-1 rounded-full bg-transparent mt-0.5"></span>
      <% end %>
    <% end %>

    <!-- 2. Q&A Library Tab -->
    <%= link_to ask_questions_path, class: "flex flex-col items-center justify-center py-1 px-2 w-full text-center transition-all duration-200 group active:scale-95 #{is_qa ? 'text-lime-300 font-bold' : 'text-emerald-200/70 hover:text-white'}" do %>
      <div class="relative flex items-center justify-center">
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" fill="<%= is_qa ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" stroke-width="<%= is_qa ? '1.5' : '2' %>">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <span class="text-[10px] mt-1 tracking-tight leading-tight">Q&amp;A</span>
      <% if is_qa %>
        <span class="w-1 h-1 rounded-full bg-lime-400 mt-0.5 shadow-[0_0_6px_#a3e635]"></span>
      <% else %>
        <span class="w-1 h-1 rounded-full bg-transparent mt-0.5"></span>
      <% end %>
    <% end %>

    <!-- 3. Central Action FAB: Ask TOM -->
    <%= link_to ask_root_path, class: "flex flex-col items-center justify-center -mt-5 group" do %>
      <div class="w-13 h-13 rounded-full bg-gradient-to-tr from-emerald-600 via-lime-400 to-lime-300 text-emerald-950 flex items-center justify-center shadow-[0_8px_20px_rgba(163,230,53,0.35)] border-[3.5px] border-[#042411] group-hover:scale-105 active:scale-90 transition-all duration-200">
        <svg class="w-6 h-6 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </div>
      <span class="text-[10px] font-black uppercase tracking-wider text-lime-300 mt-1">Ask</span>
    <% end %>

    <!-- 4. Events Tab -->
    <%= link_to events_path, class: "flex flex-col items-center justify-center py-1 px-2 w-full text-center transition-all duration-200 group active:scale-95 #{is_events ? 'text-lime-300 font-bold' : 'text-emerald-200/70 hover:text-white'}" do %>
      <div class="relative flex items-center justify-center">
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" fill="<%= is_events ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" stroke-width="<%= is_events ? '1.5' : '2' %>">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
        </svg>
      </div>
      <span class="text-[10px] mt-1 tracking-tight leading-tight">Events</span>
      <% if is_events %>
        <span class="w-1 h-1 rounded-full bg-lime-400 mt-0.5 shadow-[0_0_6px_#a3e635]"></span>
      <% else %>
        <span class="w-1 h-1 rounded-full bg-transparent mt-0.5"></span>
      <% end %>
    <% end %>

    <!-- 5. More / Menu Tab -->
    <button type="button" id="mobile-bottom-more-btn" class="flex flex-col items-center justify-center py-1 px-2 w-full text-center text-emerald-200/70 hover:text-white transition-all duration-200 group active:scale-95 cursor-pointer">
      <div class="relative flex items-center justify-center">
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </div>
      <span class="text-[10px] mt-1 tracking-tight leading-tight">More</span>
      <span class="w-1 h-1 rounded-full bg-transparent mt-0.5"></span>
    </button>

  </div>
</nav>

<script>
  (function() {
    function bindBottomNav() {
      var moreBtn = document.getElementById('mobile-bottom-more-btn');
      var openTopBtn = document.getElementById('mobile-menu-open');
      var panel = document.getElementById('mobile-menu-panel');
      if (moreBtn && panel) {
        if (!moreBtn.dataset.bottomNavBound) {
          moreBtn.dataset.bottomNavBound = '1';
          moreBtn.addEventListener('click', function(e) {
            e.preventDefault();
            panel.style.display = '';
          });
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindBottomNav);
    } else {
      bindBottomNav();
    }
    document.addEventListener('turbo:load', bindBottomNav);
  })();
</script>
