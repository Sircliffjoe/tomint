<header class="bg-white/80 backdrop-blur-md border-b border-gray-200 h-16 fixed top-0 right-0 left-0 md:left-64 z-20 flex items-center px-6 justify-between">
  <div class="flex items-center">
    <button type="button" id="sidebar-toggle" class="md:hidden mr-4 text-gray-500 hover:text-gray-700 focus:outline-none">
      <span class="sr-only">Open sidebar</span>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
    <h2 class="text-xl font-semibold text-gray-800"><%= content_for(:title) %></h2>
  </div>

  <div class="flex items-center space-x-6">
    <% if user_signed_in? %>
      <% 
        header_assigned_items = current_user.ask_assignments.includes(:ask_question, :assigned_by).active.recent.limit(5) rescue []
        header_safeguard_count = (current_user.can_access_safeguarding? ? AskQuestion.where(safeguarding_flag: true).where.not(status: [:resolved, :closed]).count : 0) rescue 0
        total_notif_count = header_assigned_items.size + (header_safeguard_count > 0 ? 1 : 0)
      %>

      <!-- Notification Bell with Dropdown -->
      <div class="relative">
        <button type="button" id="notification-bell-btn" class="relative text-gray-500 hover:text-green-600 focus:outline-none p-1.5 rounded-xl hover:bg-gray-100 transition-colors" onclick="document.getElementById('notification-dropdown').classList.toggle('hidden')">
          <span class="sr-only">Notifications</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
          <% if total_notif_count > 0 %>
            <span class="absolute top-0 right-0 w-5 h-5 rounded-full bg-rose-600 text-white text-[10px] font-black flex items-center justify-center ring-2 ring-white animate-pulse">
              <%= total_notif_count %>
            </span>
          <% end %>
        </button>

        <!-- Dropdown Menu -->
        <div id="notification-dropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-2xl shadow-xl border border-gray-200 z-50 overflow-hidden">
          <div class="p-4 border-b border-gray-100 bg-gray-50/80 flex items-center justify-between">
            <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2">
              <span>Notifications</span>
              <% if total_notif_count > 0 %>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700"><%= total_notif_count %> new</span>
              <% end %>
            </h3>
            <%= link_to "View Queue", admin_ask_questions_path(filter: "assigned_to_me"), class: "text-xs font-semibold text-emerald-700 hover:text-emerald-800" %>
          </div>

          <div class="max-h-80 overflow-y-auto divide-y divide-gray-100">
            <% if header_safeguard_count > 0 %>
              <div class="p-3.5 bg-rose-50/50 hover:bg-rose-50 transition-colors">
                <%= link_to admin_ask_safeguarding_index_path, class: "flex items-start gap-3" do %>
                  <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-rose-900">Safeguarding Alert</p>
                    <p class="text-[11px] text-rose-700 mt-0.5"><%= pluralize(header_safeguard_count, "case") %> requiring attention.</p>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if header_assigned_items.any? %>
              <% header_assigned_items.each do |assignment| %>
                <div class="p-3.5 hover:bg-emerald-50/50 transition-colors">
                  <%= link_to admin_ask_question_path(assignment.ask_question), class: "flex items-start gap-3" do %>
                    <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">
                      Q
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-gray-900"><%= assignment.ask_question.public_reference %></span>
                        <span class="text-[10px] text-gray-400"><%= time_ago_in_words(assignment.assigned_at) %> ago</span>
                      </div>
                      <p class="text-xs text-gray-600 truncate mt-0.5"><%= assignment.ask_question.display_body %></p>
                      <% if assignment.notes.present? %>
                        <p class="text-[11px] text-emerald-700 italic mt-1 bg-emerald-50 rounded px-2 py-0.5">"<%= assignment.notes %>"</p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% elsif header_safeguard_count == 0 %>
              <div class="p-6 text-center text-xs text-gray-400">
                <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                No pending assignment notifications.
              </div>
            <% end %>
          </div>

          <div class="p-3 bg-gray-50 border-t border-gray-100 text-center">
            <%= link_to "Open My Assigned Queue &rarr;".html_safe, admin_ask_questions_path(filter: "assigned_to_me"), class: "text-xs font-bold text-emerald-700 hover:text-emerald-800" %>
          </div>
        </div>
      </div>

      <!-- User Profile Link -->
      <%= link_to profile_path, class: "flex items-center group" do %>
        <div class="hidden sm:block text-right mr-3">
          <p class="text-sm font-semibold text-gray-700 group-hover:text-green-700"><%= current_user.first_name %></p>
          <p class="text-[10px] text-gray-500 uppercase tracking-widest"><%= current_user.display_role %></p>
        </div>
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar, class: "h-9 w-9 rounded-full object-cover ring-2 ring-white shadow-sm ring-offset-1 group-hover:ring-green-400 transition-all" %>
        <% else %>
          <div class="h-9 w-9 rounded-full bg-green-100 flex items-center justify-center text-green-700 font-bold group-hover:bg-green-200 transition-all">
            <%= current_user.initials %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</header>

<!-- Sidebar backdrop for mobile -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-20 md:hidden" style="display:none;"></div>

<script>
  (function() {
    function init() {
      var toggle = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('sidebar');
      var backdrop = document.getElementById('sidebar-backdrop');
      if (!toggle || !sidebar) return;

      function openSidebar() {
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        if (backdrop) backdrop.style.display = '';
      }
      function closeSidebar() {
        sidebar.classList.remove('translate-x-0');
        sidebar.classList.add('-translate-x-full');
        if (backdrop) backdrop.style.display = 'none';
      }

      toggle.addEventListener('click', function() {
        if (sidebar.classList.contains('-translate-x-full')) {
          openSidebar();
        } else {
          closeSidebar();
        }
      });
      if (backdrop) backdrop.addEventListener('click', closeSidebar);

      // Close notification dropdown when clicking outside
      document.addEventListener('click', function(event) {
        var notifBtn = document.getElementById('notification-bell-btn');
        var notifDropdown = document.getElementById('notification-dropdown');
        if (!notifBtn || !notifDropdown) return;
        if (!notifBtn.contains(event.target) && !notifDropdown.contains(event.target)) {
          notifDropdown.classList.add('hidden');
        }
      });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
  })();
</script>
