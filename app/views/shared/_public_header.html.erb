<header class="fixed inset-x-0 top-0 z-50 tom-site-header">
  <nav class="mx-auto mt-2 sm:mt-3 flex max-w-6xl items-center justify-between px-3 py-2 sm:px-6 lg:px-8 tom-nav-glass" aria-label="Global">
    <div class="flex items-center gap-3">
      <a href="<%= root_path %>" class="-m-1 p-1 flex items-center gap-2">
        <%= image_tag "logo-2.png", class: "h-9 sm:h-10 w-auto", alt: "TOM Int." %>
      </a>
    </div>

    <!-- Mobile Top Quick Actions (App Bar Right) -->
    <div class="flex items-center gap-2 lg:hidden">
      <%= link_to new_donation_path, class: "px-3 py-1 text-xs font-bold rounded-full bg-lime-400 text-emerald-950 hover:bg-lime-300 shadow-sm transition-all flex items-center gap-1 active:scale-95" do %>
        <svg class="w-3.5 h-3.5 fill-current text-rose-600" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span>Give</span>
      <% end %>

      <% if user_signed_in? %>
        <div class="tom-account-menu relative" data-account-menu>
          <button type="button" class="tom-account-trigger !w-8 !h-8 sm:!w-9 sm:!h-9 p-0.5 rounded-full border border-white/20 active:scale-95 flex items-center justify-center cursor-pointer" data-account-menu-trigger aria-haspopup="true" aria-expanded="false" aria-label="Open account menu">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover", alt: current_user.full_name %>
            <% else %>
              <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center"><%= current_user.initials %></span>
            <% end %>
          </button>

          <div class="tom-account-dropdown !w-48 !right-0 shadow-2xl" data-account-menu-panel hidden>
            <div class="px-3 py-2 border-b border-stone-100 mb-1">
              <p class="text-xs font-bold text-stone-900 truncate"><%= current_user.full_name %></p>
              <p class="text-[10px] text-emerald-700 font-medium truncate"><%= current_user.display_role %></p>
            </div>
            <%= link_to "Dashboard", dashboard_path_for_current_user, class: "tom-account-dropdown-link !text-xs !py-2" %>
            <%= link_to "Profile", profile_path, class: "tom-account-dropdown-link !text-xs !py-2" %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, form_class: "tom-account-dropdown-form", class: "tom-account-dropdown-link tom-account-dropdown-button !text-xs !py-2 !text-red-600 hover:!bg-red-50 hover:!text-red-700" %>
          </div>
        </div>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-xs font-bold text-white/90 hover:text-white px-2 py-1" %>
      <% end %>

      <button type="button" id="mobile-menu-open" class="inline-flex items-center justify-center rounded-full p-2 text-white hover:bg-white/10 active:scale-95" aria-label="Open menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    <!-- Desktop Navigation Links -->
    <div class="hidden lg:flex lg:gap-x-7" style="margin-left: 8rem;">
      <%= link_to "Home", root_path, class: "tom-nav-link" %>
      <%= link_to "About", about_path, class: "tom-nav-link" %>
      <%= link_to "Programmes", programmes_path, class: "tom-nav-link" %>
      <%= link_to "Events", events_path, class: "tom-nav-link" %>
      <%= link_to "Training", trainings_path, class: "tom-nav-link" %>
      <%= link_to "TOM ASK", ask_root_path, class: "tom-nav-link text-lime-300 font-bold" %>
      <%= link_to "Blog", blog_index_path, class: "tom-nav-link" %>
      <%= link_to "Contact", contact_path, class: "tom-nav-link" %>
    </div>

    <!-- Desktop Account / Donate -->
    <div class="hidden lg:flex lg:flex-1 lg:justify-end items-center">
      <% if user_signed_in? %>
        <div class="tom-account-menu" data-account-menu>
          <button type="button" class="tom-account-trigger" data-account-menu-trigger aria-haspopup="true" aria-expanded="false" aria-label="Open account menu">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "tom-account-avatar", alt: current_user.full_name.presence || "User avatar" %>
            <% else %>
              <span class="tom-account-avatar tom-account-avatar-fallback" aria-hidden="true"><%= current_user.initials %></span>
            <% end %>
          </button>

          <%= link_to "Donate", new_donation_path, class: "tom-btn tom-btn-light" %>

          <div class="tom-account-dropdown" data-account-menu-panel hidden>
            <%= link_to "Dashboard", dashboard_path_for_current_user, class: "tom-account-dropdown-link" %>
            <%= link_to "Profile", profile_path, class: "tom-account-dropdown-link" %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, form_class: "tom-account-dropdown-form", class: "tom-account-dropdown-link tom-account-dropdown-button" %>
          </div>
        </div>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "tom-nav-link mr-2" %>
        <%= link_to "Donate", new_donation_path, class: "tom-btn tom-btn-light" %>
      <% end %>
    </div>
  </nav>

  <!-- Mobile Menu Drawer (Native App Sheet) -->
  <div id="mobile-menu-panel" class="lg:hidden fixed inset-0 z-50 transition-opacity duration-300" style="display:none;">
    <div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-y-0 right-0 w-full max-w-xs sm:max-w-sm bg-[#042411] border-l border-emerald-500/20 text-white flex flex-col justify-between shadow-2xl overflow-y-auto">
      
      <!-- Drawer Header -->
      <div>
        <div class="flex items-center justify-between p-5 border-b border-emerald-900/80 bg-[#031d0e]">
          <div class="flex items-center gap-2.5">
            <%= image_tag "logo-2.png", class: "h-8 w-auto", alt: "TOM Int." %>
            <span class="font-bold text-sm text-lime-300 font-heading">TOM International</span>
          </div>
          <button type="button" id="mobile-menu-close" class="p-2 rounded-full text-white/70 hover:text-white hover:bg-white/10 active:scale-95 transition-all">
            <span class="sr-only">Close menu</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- User Profile Card in Drawer -->
        <% if user_signed_in? %>
          <div class="p-4 mx-4 mt-4 rounded-2xl bg-emerald-900/40 border border-emerald-500/20 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, class: "w-10 h-10 rounded-full object-cover border border-lime-400/40", alt: current_user.full_name %>
              <% else %>
                <span class="w-10 h-10 rounded-full bg-emerald-700 text-white font-bold text-sm flex items-center justify-center border border-lime-400/40"><%= current_user.initials %></span>
              <% end %>
              <div class="truncate">
                <p class="text-xs font-bold text-white truncate"><%= current_user.full_name %></p>
                <p class="text-[11px] text-lime-300 font-medium truncate"><%= current_user.display_role %></p>
              </div>
            </div>
            <%= link_to "Dashboard", dashboard_path_for_current_user, class: "px-2.5 py-1 text-[11px] font-bold rounded-lg bg-lime-400 text-emerald-950 hover:bg-lime-300 shrink-0" %>
          </div>
        <% end %>

        <!-- Categorized Nav Items -->
        <div class="p-4 space-y-4 text-xs font-semibold">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400/80 px-2 block mb-1.5">Ministry &amp; Impact</span>
            <div class="space-y-0.5">
              <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span>Home</span>
              <% end %>
              <%= link_to about_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>About Us</span>
              <% end %>
              <%= link_to programmes_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                <span>Programmes</span>
              <% end %>
              <%= link_to events_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>Events &amp; Camps</span>
              <% end %>
              <%= link_to trainings_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span>Leadership Training</span>
              <% end %>
              <%= link_to blog_index_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                <span>Blog &amp; News</span>
              <% end %>
            </div>
          </div>

          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-lime-400/90 px-2 block mb-1.5">TOM ASK — Q&amp;A</span>
            <div class="space-y-0.5">
              <%= link_to ask_root_path, class: "flex items-center justify-between px-3 py-2.5 rounded-xl bg-emerald-950/60 border border-lime-400/30 text-lime-300 font-bold hover:bg-emerald-900 transition-all active:scale-[0.98]" do %>
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Ask a Question</span>
                </div>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-lime-400 text-emerald-950 uppercase">New</span>
              <% end %>
              <%= link_to ask_questions_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span>Answered Questions Library</span>
              <% end %>
              <%= link_to ask_live_index_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 hover:text-white transition-all active:scale-[0.98]" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Live Q&amp;A Sessions</span>
              <% end %>
            </div>
          </div>

          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400/80 px-2 block mb-1.5">Connect</span>
            <div class="space-y-0.5">
              <%= link_to contact_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-white/80 hover:bg-white/10 hover:text-white transition-all" do %>
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>Contact Us</span>
              <% end %>
              <%#= link_to privacy_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-white/70 hover:bg-white/10 hover:text-white transition-all" do %>
                <!--<svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>Privacy &amp; Safeguarding</span>-->
              <%# end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Drawer Footer Action -->
      <div class="p-4 border-t border-emerald-900/80 bg-[#031d0e] space-y-3">
        <%= link_to new_donation_path, class: "w-full py-3 px-4 rounded-xl bg-lime-400 text-emerald-950 font-bold text-xs flex items-center justify-center gap-2 hover:bg-lime-300 shadow-md transition-all active:scale-[0.98]" do %>
          <svg class="w-4 h-4 fill-current text-rose-600" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          <span>Support Our Ministry &bull; Donate</span>
        <% end %>

        <% if user_signed_in? %>
          <div class="flex items-center justify-between text-xs pt-1 px-1">
            <%= link_to "My Profile", profile_path, class: "text-emerald-300 hover:text-white font-medium" %>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-red-400 hover:text-red-300 font-medium bg-transparent border-0 cursor-pointer" %>
          </div>
        <% else %>
          <div class="text-center pt-1">
            <%= link_to "Sign In to Account &rarr;".html_safe, new_user_session_path, class: "text-xs font-bold text-emerald-300 hover:text-white" %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</header>

<script>
  (function() {
    function init() {
      var openBtn = document.getElementById('mobile-menu-open');
      var closeBtn = document.getElementById('mobile-menu-close');
      var panel = document.getElementById('mobile-menu-panel');
      var backdrop = document.getElementById('mobile-menu-backdrop');
      if (!openBtn || !panel) return;
      if (openBtn.dataset.menuBound) return;
      openBtn.dataset.menuBound = '1';
      openBtn.addEventListener('click', function() { panel.style.display = ''; });
      if (closeBtn) closeBtn.addEventListener('click', function() { panel.style.display = 'none'; });
      if (backdrop) backdrop.addEventListener('click', function() { panel.style.display = 'none'; });

      document.querySelectorAll('[data-account-menu]').forEach(function(menu) {
        var trigger = menu.querySelector('[data-account-menu-trigger]');
        var accountPanel = menu.querySelector('[data-account-menu-panel]');
        if (!trigger || !accountPanel || trigger.dataset.accountMenuBound) return;
        trigger.dataset.accountMenuBound = '1';

        function closeMenu() {
          accountPanel.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
        }

        trigger.addEventListener('click', function(event) {
          event.stopPropagation();
          var willOpen = accountPanel.hidden;
          document.querySelectorAll('[data-account-menu-panel]').forEach(function(otherPanel) {
            otherPanel.hidden = true;
          });
          accountPanel.hidden = !willOpen;
          trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });

        accountPanel.addEventListener('click', function(event) {
          event.stopPropagation();
        });

        document.addEventListener('click', closeMenu);
        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape') closeMenu();
        });
      });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
    document.addEventListener('turbo:load', init);
  })();
</script>
