<% content_for :title, "Welcome to Teenagers' Outreach Ministries Inc." %>

<section class="tom-hero">
  <div class="tom-container tom-hero-layout">
    <div class="tom-hero-copy" data-reveal>
      <span class="tom-eyebrow">Impact. Discipleship. Leadership.</span>
      <h1 class="mb-4" style="font-size:54px !important">Raising Leaders. Impacting Lives.</h1>
      <p>
        Mentoring teenagers in Christ, building leaders through faith-based training, and reaching the next generation since 1992.
        We are excited to see what the future holds as we continue to reach out to teenagers and make a difference in their lives.
      </p>
      <div class="tom-hero-scripture">
        <span>Anchor Scripture</span>
        <strong>1 Timothy 4:12</strong>
        <p>"Let no one despise your youth, but be an example to the believers in word, in conduct, in love, in spirit, in faith, in purity."</p>
      </div>
      <%= form_with url: search_path, method: :get, class: "tom-hero-search", local: true do |form| %>
        <%= form.search_field :q, placeholder: "Find an event or training", aria: { label: "Search events and trainings" }, class: "tom-hero-search-input" %>
        <%= form.submit "Search", class: "tom-btn tom-btn-primary" %>
      <% end %>
      <div class="tom-hero-actions mt-4">
        <%= link_to "Contact Us", contact_path, class: "tom-btn tom-btn-primary" %>
        <%= link_to "Learn More", about_path, class: "tom-btn tom-btn-outline" %>
      </div>
    </div>

    <div class="tom-hero-image-panel" data-reveal>
      <%= image_tag "Slider-new2-scaled.png", alt: "Young leaders celebrating at a TOM programme" %>
      <div class="tom-hero-trust-card">
        <span>Since</span>
        <strong>1992</strong>
        <p>Raising Christ centered teenagers across nations.</p>
      </div>
      <div class="tom-hero-power-card">
        <span class="tom-hero-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img"><path d="M13 2 4 14h7l-1 8 10-13h-7l1-7Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <strong>Reaching. Discipling. Equipping.</strong>
          <p>Programmes that build teenagers into balanced adults.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="tom-section tom-belief-section">
  <div class="tom-container" style="margin-bottom: 30px;">
    <div class="tom-belief-grid">
      <% [
        ["Our Vision", "To share the gospel of Christ with teenagers of all Nations and disciple them unto maturity in the Christian faith.", "M12 3l8 4.5v5c0 4.2-2.8 7.2-8 8.5-5.2-1.3-8-4.3-8-8.5v-5L12 3Z"],
        ["Our Conviction", "Through flexible, dynamic fellowship, teenagers can grow beyond denominational barriers into strong faith and daily discipleship.", "M20 7 9 18l-5-5 2-2 3 3 9-9 2 2Z"],
        ["Our Strategy", "To establish Teenagers' Clubs in every neighbourhood, supported by camps, trainings, seminars, and intentional mentorship.", "M4 19V5m0 14h16M4 5h16M8 5v14m8-14v14"]
      ].each_with_index do |(title, text, icon_path), index| %>
        <article class="tom-belief-card" style="--delay:<%= index * 90 %>ms;" data-reveal>
          <span class="tom-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img"><path d="<%= icon_path %>" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3><%= title %></h3>
          <p><%= text %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="tom-feature-band tom-divided-section">
  <div class="tom-container tom-feature-split">
    <div class="tom-section-ribbon" data-reveal>
      <span>Our Story</span>
    </div>
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow">Who We Are</span>
      <h2>For over three decades, TOM has served teenagers with faith and purpose.</h2>
      <p>
        For over three decades, teenagers involved with TOM Int. represent a generation of young people who are vibrant, articulate, and poised to take their world for Christ. We are more than a ministry; we are a movement.
      </p>
      <p>
        Explore programmes designed to nurture, empower, and equip teenagers with godly values, leadership skills, and spiritual growth.
      </p>
      <%= link_to "Our Story", about_path, class: "tom-btn tom-btn-primary", style: "margin-top:1rem;" %>
    </div>
    <div class="tom-media" data-reveal>
      <%= image_tag "TOM-Kwali-Bible-Reading4-scaled-1.jpg", alt: "Bible reading and discipleship session", loading: "lazy" %>
    </div>
  </div>
</section>

<section class="tom-dark-feature">
  <div class="tom-container tom-training-layout">
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-yellow);">Training Culture</span>
      <h2 style="color:white;">TOM lays a lot of emphasis on training.</h2>
      <p>No one can do well, what he or she has not been trained to do. We equip workers and leaders.</p>
      <%= link_to "View Training", trainings_path, class: "tom-btn tom-btn-light", style: "margin-top:1rem;" %>
    </div>
    <div class="tom-training-collage" data-reveal>
      <%= image_tag "WhatsApp-Image-2025-04-26-at-3.22.56-AM.jpeg", alt: "Teenagers at a training programme", loading: "lazy", class: "is-tilt-left" %>
      <%= image_tag "TOM-Kwali-Bible-Reading4-scaled-1.jpg", alt: "Bible reading training session", loading: "lazy", class: "is-tilt-right" %>
      <%= image_tag "WhatsApp-Image-2025-04-26-at-3.23.18-AM.jpeg", alt: "Ministry workers learning together", loading: "lazy", class: "is-tilt-soft" %>
    </div>
  </div>
</section>

<section class="tom-feature-band">
  <div class="tom-container tom-feature-split is-reverse" style="margin-bottom: 30px;">
    <div class="tom-media" data-reveal>
      <%= image_tag "WhatsApp-Image-2025-04-26-at-3.23.07-AM.jpeg", alt: "Teenagers in a discipleship circle", loading: "lazy" %>
    </div>
    <div class="tom-copy" data-reveal>
      <span class="tom-eyebrow">Serve With TOM</span>
      <h2>Become A Proud Volunteer</h2>
      <p>Reach out to learn how your time and passion can make a lasting impact on teenagers.</p>
      <p>These are programmes aimed at getting our teens to become Christ centered and balanced adults who are pillars in their generation.</p>
      <%= link_to "Contact Us", contact_path, class: "tom-btn tom-btn-primary", style: "margin-top:1rem;" %>
    </div>
  </div>
</section>

<section class="tom-section tom-divided-section">
  <div class="tom-container">
    <div class="tom-section-ribbon" data-reveal>
      <span>Programmes</span>
    </div>
    <div class="tom-section-title" data-reveal>
      <div>
        <span class="tom-eyebrow">Featured Programmes</span>
        <h2>What We Do</h2>
      </div>
      <p>Dynamic programmes for outreach, discipleship, leadership, and spiritual growth.</p>
    </div>

    <div class="tom-resource-grid tom-programme-grid">
      <% [
        ["Outreach", "Through dynamic programmes like Teenagers' Clubs, Vacation Camps, and School Seminars, we reach teenagers in their everyday environments.", events_path, "var(--tom-teal)"],
        ["Training", "TOM lays a lot of emphasis on training. No one can do well, what he or she has not been trained to do.", trainings_path, "var(--tom-yellow)"],
        ["Discipleship", "These are programmes aimed at getting our teens to become Christ centered and balanced adults.", about_path, "var(--tom-purple)"]
      ].each do |title, text, path, accent| %>
        <%= link_to path, class: "tom-resource-card", style: "--accent: #{accent};", data: { reveal: true } do %>
          <small>A TOM Focus</small>
          <h3><%= title %></h3>
          <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= text %></p>
        <% end %>
      <% end %>
    </div>

    <p style="margin-top:2rem;color:var(--tom-muted);">Explore our full line by category...</p>
    <div class="tom-category-grid" style="margin-top:1rem;">
      <% [
        ["Teenagers' Clubs", about_path, "var(--tom-teal)"],
        ["Camps", events_path, "var(--tom-orange)"],
        ["Parent Guides", blog_index_path, "var(--tom-purple)"],
        ["Training", trainings_path, "var(--tom-yellow)"],
        ["Outreach", events_path, "var(--tom-blue)"],
        ["Blog", blog_index_path, "var(--tom-green-700)"]
      ].each do |label, path, accent| %>
        <%= link_to path, class: "tom-category-tile", style: "--accent:#{accent};", data: { reveal: true } do %>
          <span><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="tom-band" style="padding-block:4rem;">
  <div class="tom-container">
    <div class="tom-section-title" data-reveal>
      <div>
        <span class="tom-eyebrow" style="color:var(--tom-yellow);">Our FunFact</span>
        <h2 style="color:white;">A Glimpse of Our Journey Across the World...</h2>
      </div>
      <p style="color:rgba(255,255,255,.82);">We've come a long way – and we're just getting started! From humble beginnings to a growing international family, these highlights make our journey exciting and worth celebrating.</p>
    </div>
    <div class="tom-funfact-kicker" data-reveal>
      <span class="tom-spark" aria-hidden="true"></span>
      <p>"Give A Hand To Make The Better World"</p>
      <span class="tom-spark" aria-hidden="true"></span>
    </div>
    <div class="tom-stat-grid tom-funfact-grid">
      <% [
        ["16 M+", "Teens Reached", "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm14 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"],
        ["60 +", "TOM Clubs", "M3 21h18M5 21V7l7-4 7 4v14M9 21v-7h6v7"],
        ["750,000 +", "Workers Trained", "M22 10 12 5 2 10l10 5 10-5ZM6 12v5c3 3 9 3 12 0v-5"]
      ].each_with_index do |(number, label, icon_path), index| %>
        <div class="tom-stat-card tom-funfact-card" style="--delay:<%= index * 120 %>ms;" data-reveal>
          <span class="tom-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img"><path d="<%= icon_path %>" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <strong><%= number %></strong>
          <span style="display:block;margin-top:.5rem;color:var(--tom-muted);font-weight:700;"><%= label %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="tom-section bg-white">
  <div class="tom-container">
    <div class="tom-section-title" data-reveal>
      <div>
        <span class="tom-eyebrow">Upcoming</span>
        <h2>Featured Events</h2>
      </div>
      <p>Be part of what's coming next! Join us for impactful camps, trainings, and outreaches designed to empower and inspire.</p>
    </div>

    <div class="tom-resource-grid tom-featured-events-grid">
      <% if @upcoming_events.present? %>
        <% @upcoming_events.first(3).each_with_index do |event, index| %>
          <% accent = ["var(--tom-teal)", "var(--tom-orange)", "var(--tom-yellow)", "var(--tom-purple)"][index % 4] %>
          <%= link_to event_path(event), class: "tom-resource-card", style: "--accent: #{accent};", data: { reveal: true } do %>
            <small><%= event.start_time.strftime("%b %d, %Y") %></small>
            <h3><%= event.title %></h3>
            <p style="margin-top:.75rem;color:var(--tom-muted);font-size:.92rem;"><%= event.location.presence || event.state&.name || "National" %></p>
            <span class="tom-btn tom-btn-primary" style="margin-top:1rem;">Register</span>
          <% end %>
        <% end %>
      <% else %>
        <div class="tom-card" style="grid-column:1/-1;padding:2rem;text-align:center;" data-reveal>
          <h3>No upcoming events</h3>
          <p style="margin-top:.5rem;color:var(--tom-muted);">Check back soon for exciting events and programmes.</p>
        </div>
      <% end %>
    </div>
    <%= link_to "All Events", events_path, class: "tom-btn tom-btn-outline mt-4" %>
  </div>
</section>

<section class="tom-section bg-white tom-divided-section">
  <div class="tom-container">
    <div class="tom-section-ribbon" data-reveal>
      <span>Community Voices</span>
    </div>
    <div class="tom-section-title" data-reveal>
      <div>
        <span class="tom-eyebrow">Testimonials</span>
        <h2>What People are Saying</h2>
      </div>
      <p>Here’s what people are saying about their experience.</p>
    </div>

    <div class="tom-scroll-row" style="margin-bottom:3rem;">
      <% [
        ["Uncle Clifford", "Delta State Coordinator", "TOM has been a transformational platform for teenagers across Nigeria. The impact we see in young lives is truly remarkable and life-changing."],
        ["Sis. Amaka", "Youth Worker", "Being part of TOM has given me the tools and training to effectively reach and mentor teenagers in my community. The growth has been phenomenal."],
        ["Bro. David", "Camp Volunteer", "The vacation camps are life-changing experiences. I've watched teenagers come in broken and leave with renewed hope, purpose, and faith in Christ."],
        ["Sis. Grace", "Parent", "My children have grown spiritually and in character since joining TOM programmes. I am deeply grateful for this ministry and its impact on families."],
        ["Bro. Emmanuel", "Training Facilitator", "TOM's emphasis on training workers is what sets it apart. You can't give what you don't have, and TOM invests heavily in equipping leaders."],
        ["Sis. Favour", "Teen Club Member", "I gave my life to Christ at a TOM Camp 2018. Now as an ambassador, I am helping to lead a Teenagers' Club in my Church. God is truly faithful!"]
      ].first(3).each do |name, role, text| %>
        <article class="tom-card" style="padding:1.25rem;" data-reveal>
          <p style="color:var(--tom-muted);line-height:1.65;">"<%= text %>"</p>
          <h3 style="margin-top:1rem;"><%= name %></h3>
          <p style="color:var(--tom-teal);font-weight:800;font-size:.9rem;"><%= role %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="tom-band" style="padding-block:4rem;text-align:center;">
  <div class="tom-container" data-reveal>
    <p style="color:rgba(255,255,255,.82);font-weight:800;">Teenagers' Outreach Ministries (TOM) Inc.</p>
    <h2 style="color:white;margin-top:.5rem;">Help us reach the rising generation.</h2>
    <%= link_to "Donate", new_donation_path, class: "tom-btn tom-btn-primary", style: "margin-top:1.25rem;" %>
  </div>
</section>

<section class="tom-section bg-white tom-divided-section tom-soft-section">
  <div class="tom-container">
    <div class="tom-section-ribbon" data-reveal>
      <span>Latest Stories</span>
    </div>
    <div class="tom-section-title" data-reveal>
      <div>
        <span class="tom-eyebrow">From The Blog</span>
        <h2>Stories of impact, upcoming events, and ministry updates.</h2>
      </div>
    </div>

    <div class="tom-resource-grid tom-blog-grid">
      <% @latest_posts.first(3).each_with_index do |post, index| %>
        <% accent = ["var(--tom-teal)", "var(--tom-yellow)", "var(--tom-orange)"][index % 3] %>
        <article class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal>
          <small><%= post.published_at.strftime("%b %d, %Y") %></small>
          <h3><%= link_to post.title, blog_path(post) %></h3>
          <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;font-size:.92rem;"><%= post.body.to_plain_text.truncate(150) %></p>
        </article>
      <% end %>
    </div>
    <%= link_to "View More", blog_index_path, class: "tom-btn tom-btn-outline mt-4" %>
  </div>
</section>
