<% content_for :title, @announcement.title %>

<div class="min-h-screen bg-gray-50" style="padding-top: 180px;">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <% if @announcement.image.attached? %>
      <div class="overflow-hidden rounded-2xl shadow-lg" style="max-height: 400px;">
        <%= image_tag @announcement.image, class: "w-full h-full object-cover", alt: @announcement.title %>
      </div>
    <% else %>
      <div class="overflow-hidden rounded-2xl bg-gradient-to-br from-leaf-800 to-leaf-950 flex items-center justify-center" style="height: 280px;">
        <svg style="width:64px;height:64px;" class="text-white/30" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H6.75A2.25 2.25 0 014.5 13.5v-3A2.25 2.25 0 016.75 8.25h1.5c.704 0 1.402-.03 2.09-.09m0 7.68c1.617.14 3.153.638 4.558 1.42A.75.75 0 0016 16.61V7.39a.75.75 0 00-1.102-.66 12.014 12.014 0 01-4.558 1.43m0 7.68V8.16m7.5 4.59h.008v.008h-.008v-.008z" />
        </svg>
      </div>
    <% end %>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-8 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-sm font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
            Announcement
          </span>
          <% if @announcement.priority? %>
            <span class="inline-flex items-center rounded-full bg-yellow-50 px-3 py-1 text-sm font-medium text-yellow-700 ring-1 ring-inset ring-yellow-600/20">
              Priority
            </span>
          <% end %>
        </div>

        <h1 class="mt-5 text-2xl sm:text-3xl font-bold tracking-tight text-gray-900" style="line-height: 1.25;">
          <%= @announcement.title %>
        </h1>

        <div class="mt-6 flex items-start gap-4">
          <div class="flex-shrink-0 rounded-xl bg-white border border-gray-200 text-center shadow-sm overflow-hidden" style="width:56px;">
            <div class="bg-leaf-600 text-white text-[10px] font-bold uppercase tracking-wider py-1">
              <%= @announcement.created_at.strftime("%b") %>
            </div>
            <div class="py-2">
              <span class="text-xl font-extrabold text-gray-900 leading-none"><%= @announcement.created_at.strftime("%d") %></span>
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900"><%= @announcement.created_at.strftime("%A, %B %d, %Y") %></p>
            <p class="text-sm text-gray-500 mt-0.5">Published announcement</p>
          </div>
        </div>

        <hr class="my-8 border-gray-200">

        <div>
          <h2 class="text-lg font-bold text-gray-900 mt-10">Announcement Details</h2>
          <div class="mt-4 prose prose-sm prose-green max-w-none text-gray-600 mb-bb" style="line-height: 1.8;">
            <%= simple_format @announcement.description %>
          </div>
        </div>

        <div class="mb-bb mt-12">
          <%= link_to root_path, class: "inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-leaf-600 transition-colors" do %>
            <svg style="width:16px;height:16px;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Home
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-1">
        <div class="sticky" style="top: 120px;">
          <div class="rounded-2xl bg-white border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-100">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Published</span>
              <p class="mt-2 text-2xl font-bold text-gray-900"><%= @announcement.created_at.strftime("%b %d") %></p>
              <p class="text-sm text-gray-500"><%= @announcement.created_at.strftime("%Y") %></p>
            </div>

            <div class="px-6 py-5">
              <div class="rounded-xl bg-green-50 p-4">
                <div class="flex items-center gap-2">
                  <svg style="width:18px;height:18px;min-width:18px;" class="text-green-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-sm font-semibold text-green-800">Ministry update</span>
                </div>
                <p class="mt-2 text-xs text-green-700">Shared for public notice and follow-up.</p>
              </div>

              <%= link_to "Return Home", root_path, class: "mt-4 block w-full text-center rounded-xl bg-leaf-600 px-4 py-3 text-sm font-bold text-white shadow-sm hover:bg-leaf-500 transition-all" %>
            </div>

            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/50">
              <div class="flex items-center justify-between">
                <span class="text-xs text-gray-500">Status</span>
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-700">
                  <span class="relative flex" style="width:6px;height:6px;">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full bg-green-500" style="width:6px;height:6px;"></span>
                  </span>
                  Active
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .mb-bb { margin-bottom: 100px !important; }
</style>
