<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Countries</h1>
      <p class="text-sm text-gray-500">Manage TOM countries and their state or regional chapters.</p>
    </div>
    <%= link_to "New Country", new_admin_country_path, class: "inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-700" %>
  </div>

  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Code</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">States / Regions</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Zones</th>
          <th class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @countries.each do |country| %>
          <tr>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to country.name, admin_country_path(country), class: "hover:text-green-600" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= country.code %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= country.status.humanize %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= country.states.size %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= country.zones.size %></td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <%= link_to "Edit", edit_admin_country_path(country), class: "mr-4 text-green-600 hover:text-green-900" %>
              <%= link_to "Delete", admin_country_path(country), data: { turbo_method: :delete, turbo_confirm: "Delete this country?" }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
