<% content_for :title, "TOM ASK System Settings" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to admin_ask_dashboard_path, class: "p-2 rounded-xl bg-white border border-stone-200 text-stone-600 hover:bg-stone-50" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-extrabold text-stone-900">TOM ASK System Settings</h1>
      <p class="text-xs text-stone-500">Configure public copy, privacy statements, and platform text.</p>
    </div>
  </div>

  <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 sm:p-8">
    <%= form_with url: admin_ask_settings_path, method: :patch, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-stone-700 mb-1">Headline &amp; Tagline</label>
        <input type="text" name="ask_headline" value="<%= @headline %>" class="w-full p-3 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
        <span class="text-[11px] text-stone-400 mt-1 block">Default: "You can ask. We will listen."</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-700 mb-1">Introductory Text (Landing Page)</label>
        <textarea name="ask_intro_text" rows="3" class="w-full p-3 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"><%= @intro_text %></textarea>
        <span class="text-[11px] text-stone-400 mt-1 block">Displayed on /ask hero banner.</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-700 mb-1">Privacy &amp; Safeguarding Notice</label>
        <textarea name="ask_privacy_notice" rows="4" class="w-full p-3 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"><%= @privacy_notice %></textarea>
        <span class="text-[11px] text-stone-400 mt-1 block">Displayed to teenagers before submitting a question.</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-700 mb-1">Urgent Help Message</label>
        <textarea name="ask_urgent_help_text" rows="3" class="w-full p-3 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"><%= @urgent_help_text %></textarea>
      </div>

      <div class="flex justify-end pt-4 border-t border-stone-100">
        <%= f.submit "Save Settings", class: "px-6 py-2.5 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-800 shadow cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
