<% content_for :title, "Safeguarding Case: #{@question.public_reference}" %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-rose-950 text-white p-6 rounded-3xl shadow-lg border border-rose-800">
    <div class="flex items-center gap-3">
      <%= link_to admin_ask_safeguarding_index_path, class: "p-2 rounded-xl bg-white/10 text-white hover:bg-white/20" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      <% end %>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-sm font-black text-rose-200 bg-rose-900 px-2.5 py-0.5 rounded border border-rose-700">
            <%= @question.public_reference %>
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-600 text-white">
            <%= @question.status.humanize %>
          </span>
          <% if @question.urgent_flag? %>
            <span class="px-2 py-0.5 rounded text-xs font-black bg-rose-500 text-white animate-pulse">
              URGENT
            </span>
          <% end %>
        </div>
        <h1 class="text-xl font-bold text-white mt-1">Confidential Safeguarding Case File</h1>
      </div>
    </div>

    <!-- Status Change Dropdown -->
    <%= form_with url: update_status_admin_ask_safeguarding_path(@question), method: :patch, class: "flex items-center gap-2" do |f| %>
      <%= f.select :status, [
        ["Safeguarding Review", "safeguarding_review"],
        ["Safeguarding Escalated", "safeguarding_escalated"],
        ["Urgent Action", "urgent"],
        ["Resolved", "resolved"],
        ["Closed", "closed"]
      ], { selected: @question.status }, class: "p-2 text-xs rounded-xl bg-stone-900 border border-rose-700 text-white focus:outline-none" %>
      <%= f.submit "Update Status", class: "px-3 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 cursor-pointer" %>
    <% end %>
  </div>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column (2 Cols): Full Disclosure & Case Actions -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Full Disclosure Card -->
      <div class="bg-white rounded-3xl border border-rose-200 shadow-sm p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-stone-100 pb-3">
          <span class="text-xs font-bold text-rose-800 uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            Teenager Disclosure
          </span>
          <span class="text-xs text-stone-400">Received <%= @question.submitted_at.strftime("%b %d, %Y at %I:%M %p") %></span>
        </div>

        <div class="p-6 rounded-2xl bg-rose-50/70 border border-rose-200 text-stone-900 text-base sm:text-lg leading-relaxed whitespace-pre-line font-medium">
          <%= @question.body %>
        </div>

        <% if @question.moderation_reason.present? %>
          <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900">
            <strong>System Detection Flags:</strong> <%= @question.moderation_reason %>
          </div>
        <% end %>

        <% if @question.has_contact_info? %>
          <div class="p-4 rounded-2xl bg-indigo-50 border border-indigo-200 flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-xs font-bold text-indigo-950 uppercase tracking-wider block">Supplied Contact Info</span>
              <span class="text-sm font-semibold text-indigo-800"><%= @question.contact_method.humanize %>: <%= @question.contact_details %></span>
            </div>
            <% if @question.whatsapp? || @question.phone? %>
              <% clean_phone = @question.contact_details.gsub(/[^0-9]/, "") %>
              <% clean_phone = "234" + clean_phone[1..] if clean_phone.start_with?("0") %>
              <a href="https://wa.me/<%= clean_phone %>?text=Hello,%20this%20is%20the%20Safeguarding%20Team%20at%20TOM%20International%20regarding%20your%20TOM%20ASK%20submission%20(<%= @question.public_reference %>)." target="_blank" class="px-4 py-2 rounded-xl bg-green-600 text-white text-xs font-bold hover:bg-green-700 shadow flex items-center gap-2">
                Open WhatsApp &rarr;
              </a>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Formal Escalation Section -->
      <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 sm:p-8 space-y-6">
        <h2 class="text-base font-bold text-stone-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Safeguarding Escalation &amp; Case Management
        </h2>

        <!-- Active Escalation Details if present -->
        <% if @active_escalation %>
          <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-stone-900"><%= @active_escalation.escalation_type.humanize %></span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= @active_escalation.severity_badge_class %>">
                  <%= @active_escalation.severity.upcase %>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= @active_escalation.status_badge_class %>">
                  <%= @active_escalation.status.humanize %>
                </span>
              </div>
              <span class="text-xs text-stone-400">Escalated by <%= @active_escalation.created_by.first_name %></span>
            </div>

            <p class="text-xs text-stone-700"><strong>Reason:</strong> <%= @active_escalation.reason %></p>
            <% if @active_escalation.action_taken_notes.present? %>
              <p class="text-xs text-stone-700"><strong>Action Taken:</strong> <%= @active_escalation.action_taken_notes %></p>
            <% end %>
          </div>
        <% end %>

        <!-- New Escalation Form -->
        <%= form_with model: @escalation, url: escalate_admin_ask_safeguarding_path(@question), method: :post, class: "space-y-4" do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div>
              <%= f.label :escalation_type, "Escalation Type", class: "block font-semibold text-stone-700 mb-1" %>
              <%= f.select :escalation_type, AskEscalation.escalation_types.keys.map { |t| [t.humanize, t] }, {}, class: "w-full p-2.5 rounded-xl border border-stone-300 bg-white" %>
            </div>

            <div>
              <%= f.label :severity, "Severity Level", class: "block font-semibold text-stone-700 mb-1" %>
              <%= f.select :severity, AskEscalation.severities.keys.map { |s| [s.humanize, s] }, {}, class: "w-full p-2.5 rounded-xl border border-stone-300 bg-white" %>
            </div>

            <div>
              <%= f.label :assigned_safeguarding_lead_id, "Safeguarding Officer", class: "block font-semibold text-stone-700 mb-1" %>
              <%= f.collection_select :assigned_safeguarding_lead_id, @safeguarding_leads, :id, :full_name, { prompt: "Assign Lead" }, class: "w-full p-2.5 rounded-xl border border-stone-300 bg-white" %>
            </div>
          </div>

          <div>
            <%= f.label :reason, "Escalation Assessment / Summary", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.text_area :reason, rows: 3, required: true, placeholder: "Describe the nature of the risk and rationale for escalation...", class: "w-full p-3 text-xs rounded-xl border border-stone-300" %>
          </div>

          <div>
            <%= f.label :action_taken_notes, "Action Plan / External Referrals (optional)", class: "block text-xs font-semibold text-stone-700 mb-1" %>
            <%= f.text_area :action_taken_notes, rows: 2, placeholder: "e.g. Referred to local child protection officer, contacted parent/guardian under safeguarding policy...", class: "w-full p-3 text-xs rounded-xl border border-stone-300" %>
          </div>

          <div class="flex justify-end">
            <%= f.submit "Record Formal Escalation", class: "px-6 py-2.5 rounded-xl bg-rose-700 text-white font-bold text-xs hover:bg-rose-800 shadow cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column (1 Col): Confidential Notes & Audit Log -->
    <div class="space-y-6">
      <!-- Confidential Safeguarding Notes -->
      <div class="bg-white rounded-3xl border border-rose-200 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-stone-900">Confidential Case Notes</h3>
          <span class="text-[10px] font-black text-rose-600 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">RESTRICTED</span>
        </div>

        <div class="space-y-3 max-h-64 overflow-y-auto pr-1">
          <% if @internal_notes.any? %>
            <% @internal_notes.each do |note| %>
              <div class="p-3 rounded-2xl bg-rose-50/50 border border-rose-100 text-xs space-y-1">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span class="font-bold text-rose-900"><%= note.user&.full_name || "Safeguarding Lead" %></span>
                  <span><%= time_ago_in_words(note.created_at) %> ago</span>
                </div>
                <p class="text-stone-800"><%= note.body %></p>
              </div>
            <% end %>
          <% else %>
            <p class="text-xs text-stone-400 text-center py-2">No case notes logged yet.</p>
          <% end %>
        </div>

        <%= form_with model: [@question, @question.ask_internal_notes.build(safeguarding_only: true)], url: admin_ask_question_internal_notes_path(@question), class: "space-y-2" do |f| %>
          <%= f.hidden_field :safeguarding_only, value: true %>
          <%= f.text_area :body, rows: 3, placeholder: "Add confidential case note...", required: true, class: "w-full p-2.5 text-xs rounded-xl border border-stone-300 focus:ring-2 focus:ring-rose-500" %>
          <%= f.submit "Add Confidential Note", class: "w-full py-2 rounded-xl bg-rose-700 text-white font-bold text-xs hover:bg-rose-800 cursor-pointer" %>
        <% end %>
      </div>

      <!-- Audit Trail -->
      <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 space-y-3">
        <h3 class="text-sm font-bold text-stone-900">Audit Trail</h3>

        <div class="space-y-2.5 max-h-56 overflow-y-auto pr-1 text-xs">
          <% if @moderation_actions.any? %>
            <% @moderation_actions.each do |act| %>
              <div class="border-l-2 border-rose-500 pl-2.5 py-0.5">
                <p class="font-semibold text-stone-800">
                  <span class="text-rose-700"><%= act.user&.first_name %></span>: <%= act.action.humanize %>
                </p>
                <% if act.details.present? %>
                  <p class="text-[11px] text-stone-500"><%= act.details %></p>
                <% end %>
                <span class="text-[10px] text-stone-400"><%= time_ago_in_words(act.created_at) %> ago</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
