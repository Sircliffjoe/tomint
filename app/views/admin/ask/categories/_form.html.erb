<%= form_with model: category, url: (category.persisted? ? admin_ask_category_path(category) : admin_ask_categories_path), class: "space-y-4" do |f| %>
  <% if category.errors.any? %>
    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs">
      <p class="font-bold mb-1"><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</p>
      <ul class="list-disc list-inside">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Category Name", class: "block text-xs font-semibold text-stone-700 mb-1" %>
    <%= f.text_field :name, required: true, placeholder: "e.g. Faith & God, Relationships & Dating", class: "w-full p-3 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (URL identifier)", class: "block text-xs font-semibold text-stone-700 mb-1" %>
    <%= f.text_field :slug, placeholder: "e.g. faith-god (leave blank to auto-generate)", class: "w-full p-2.5 rounded-xl border border-stone-300 text-xs" %>
  </div>

  <div>
    <%= f.label :description, "Description", class: "block text-xs font-semibold text-stone-700 mb-1" %>
    <%= f.text_area :description, rows: 3, placeholder: "Briefly explain what questions fit into this category...", class: "w-full p-3 rounded-xl border border-stone-300 text-sm" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
    <div>
      <%= f.label :color, "Color Theme", class: "block font-semibold text-stone-700 mb-1" %>
      <%= f.select :color, [
        ["Emerald / Green", "emerald"],
        ["Blue / Sky", "blue"],
        ["Purple / Indigo", "purple"],
        ["Amber / Yellow", "amber"],
        ["Rose / Red", "rose"],
        ["Orange", "orange"]
      ], {}, class: "w-full p-2.5 rounded-xl border border-stone-300 bg-white" %>
    </div>

    <div>
      <%= f.label :position, "Display Order", class: "block font-semibold text-stone-700 mb-1" %>
      <%= f.number_field :position, class: "w-full p-2.5 rounded-xl border border-stone-300" %>
    </div>
  </div>

  <div class="pt-2">
    <label class="flex items-center gap-2 text-xs font-semibold text-stone-700 cursor-pointer">
      <%= f.check_box :active, class: "rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" %>
      Active (Available for teen question submission)
    </label>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
    <%= link_to "Cancel", admin_ask_categories_path, class: "px-5 py-2 rounded-xl border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100" %>
    <%= f.submit category.new_record? ? "Create Category" : "Save Changes", class: "px-6 py-2 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-800 shadow cursor-pointer" %>
  </div>
<% end %>
