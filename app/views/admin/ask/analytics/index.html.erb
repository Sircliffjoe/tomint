<% content_for :title, "TOM ASK Analytics & Insights" %>

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-stone-900">TOM ASK Analytics</h1>
      <p class="text-xs sm:text-sm text-stone-500 mt-0.5">Aggregated metrics and engagement trends across TOM teen outreach.</p>
    </div>

    <%= link_to admin_ask_dashboard_path, class: "px-4 py-2 rounded-xl border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100" do %>
      &larr; Dashboard
    <% end %>
  </div>

  <!-- Key Metrics Summary -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-stone-400 uppercase tracking-wider block">Total Questions</span>
      <p class="text-2xl sm:text-3xl font-black text-stone-900 mt-1"><%= @total_questions %></p>
    </div>

    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider block">Answered &amp; Public</span>
      <p class="text-2xl sm:text-3xl font-black text-emerald-600 mt-1"><%= @public_answered %></p>
    </div>

    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-indigo-700 uppercase tracking-wider block">Private Requests</span>
      <p class="text-2xl sm:text-3xl font-black text-indigo-600 mt-1"><%= @private_requests %></p>
    </div>

    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-amber-700 uppercase tracking-wider block">Help Requests</span>
      <p class="text-2xl sm:text-3xl font-black text-amber-600 mt-1"><%= @help_requests %></p>
    </div>

    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-emerald-800 uppercase tracking-wider block">Live Sessions</span>
      <p class="text-2xl sm:text-3xl font-black text-emerald-800 mt-1"><%= @total_live_sessions %></p>
    </div>

    <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm">
      <span class="text-[11px] font-bold text-rose-700 uppercase tracking-wider block">Safeguarding Flags</span>
      <p class="text-2xl sm:text-3xl font-black text-rose-600 mt-1"><%= @safeguarding_count %></p>
    </div>
  </div>

  <!-- Charts & Breakdowns Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Category Distribution -->
    <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 space-y-4">
      <h2 class="text-base font-bold text-stone-900">Questions by Category</h2>
      
      <div class="space-y-3">
        <% if @category_breakdown.any? %>
          <% max_count = @category_breakdown.values.max.to_f %>
          <% @category_breakdown.each do |category_name, count| %>
            <% percentage = max_count > 0 ? ((count / max_count) * 100).round : 0 %>
            <div class="space-y-1 text-xs">
              <div class="flex items-center justify-between font-semibold">
                <span class="text-stone-800"><%= category_name %></span>
                <span class="text-stone-500"><%= count %></span>
              </div>
              <div class="w-full h-2.5 bg-stone-100 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-600 rounded-full transition-all" style="width: <%= percentage %>%;"></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-stone-400 text-center py-6">No data yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Response Preference Breakdown -->
    <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 space-y-4">
      <h2 class="text-base font-bold text-stone-900">Response Preferences</h2>

      <div class="space-y-3">
        <% if @preference_breakdown.any? %>
          <% @preference_breakdown.each do |pref_name, count| %>
            <div class="p-3.5 rounded-2xl bg-stone-50 border border-stone-200 flex items-center justify-between text-xs">
              <span class="font-bold text-stone-800"><%= pref_name %></span>
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold"><%= count %> questions</span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-stone-400 text-center py-6">No data yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Most Popular / Upvoted Questions in Public Library -->
  <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 space-y-4">
    <h2 class="text-base font-bold text-stone-900">Top Answered Questions by Engagement</h2>

    <div class="space-y-3">
      <% if @top_questions.any? %>
        <% @top_questions.each do |q| %>
          <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200 flex items-center justify-between gap-4 text-xs">
            <div class="flex-1">
              <span class="font-mono text-[10px] text-stone-400"><%= q.public_reference %></span>
              <p class="font-bold text-stone-900 line-clamp-1"><%= q.display_body %></p>
            </div>
            <div class="flex items-center gap-3 text-stone-500 font-semibold shrink-0">
              <span><%= q.views_count %> views</span>
              <span class="text-emerald-700 font-bold">▲ <%= q.upvotes_count %> votes</span>
              <%= link_to "View", ask_question_path(q), target: "_blank", class: "text-emerald-700 hover:underline" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-stone-400 text-center py-6">No public questions with engagement recorded yet.</p>
      <% end %>
    </div>
  </div>
</div>
