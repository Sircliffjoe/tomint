<% content_for :title, "New Live Q&A Session — TOM ASK" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to admin_ask_live_sessions_path, class: "p-2 rounded-xl bg-white border border-stone-200 text-stone-600 hover:bg-stone-50" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-extrabold text-stone-900">Create Live Q&amp;A Session</h1>
      <p class="text-xs text-stone-500">Configure a real-time question session for your camp or outreach.</p>
    </div>
  </div>

  <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm p-6 sm:p-8">
    <%= render "form", live_session: @live_session %>
  </div>
</div>
