<% content_for :title, "QR Code: #{@live_session.title}" %>

<div class="max-w-md mx-auto space-y-6 text-center py-8">
  <div class="flex items-center justify-between">
    <%= link_to admin_ask_live_session_path(@live_session), class: "px-3 py-1.5 rounded-xl border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100" do %>
      &larr; Back to Session
    <% end %>
    <span class="font-mono text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded border border-emerald-200">
      CODE: <%= @live_session.access_code %>
    </span>
  </div>

  <div class="bg-white rounded-3xl border border-stone-200/90 shadow-xl p-8 space-y-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Scan to Join Live Q&amp;A</span>
      <h1 class="text-xl font-extrabold text-stone-900 mt-1"><%= @live_session.title %></h1>
    </div>

    <!-- QR Code Display -->
    <div class="w-64 h-64 mx-auto flex items-center justify-center p-4 bg-stone-50 rounded-2xl border border-stone-200 shadow-inner">
      <%== @qr_svg %>
    </div>

    <div class="space-y-1">
      <p class="text-xs text-stone-500">Direct Link:</p>
      <p class="text-xs font-mono font-bold text-stone-800 break-all select-all bg-stone-100 p-2 rounded-lg"><%= @public_url %></p>
    </div>

    <div class="flex items-center justify-center gap-3 pt-4 border-t border-stone-100">
      <%= link_to "Download PNG", qr_code_admin_ask_live_session_path(@live_session, format: :png), class: "px-5 py-2.5 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-800 shadow" %>
      <%= link_to "Download SVG", qr_code_admin_ask_live_session_path(@live_session, format: :svg), class: "px-5 py-2.5 rounded-xl border border-stone-300 text-stone-700 font-semibold text-xs hover:bg-stone-100" %>
    </div>
  </div>
</div>
