<div class="px-4 py-8 sm:px-6 lg:px-8 w-full max-w-7xl mx-auto">
  <div class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-sm text-gray-500">
        <%= link_to "Blog Posts", admin_blog_posts_path, class: "transition-colors hover:text-green-600" %>
        <svg class="h-4 w-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="truncate text-gray-700"><%= @blog_post.title %></span>
      </div>

      <h1 class="mt-3 max-w-4xl text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">
        <%= @blog_post.title %>
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-500">
        <% if @blog_post.published_at.present? && @blog_post.published_at <= Time.current %>
          <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 font-semibold text-green-700">Published</span>
        <% elsif @blog_post.published_at.present? && @blog_post.published_at > Time.current %>
          <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 font-semibold text-amber-700">Scheduled</span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 font-semibold text-gray-700">Draft</span>
        <% end %>

        <span>By <%= @blog_post.author&.full_name || "Unknown Author" %></span>
        <span class="text-gray-300">•</span>
        <span><%= pluralize((@blog_post.body.to_plain_text.split.size / 200.0).ceil.clamp(1, 12), "minute") %> read</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to edit_admin_blog_post_path(@blog_post), class: "inline-flex items-center gap-2 rounded-xl border border-green-200 bg-white px-4 py-3 text-sm font-semibold text-green-700 shadow-sm transition-colors hover:border-green-300 hover:bg-green-50" do %>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="M11.7.3c-.4-.4-1-.4-1.4 0l-10 10c-.2.2-.3.4-.3.7v4c0 .6.4 1 1 1h4c.3 0 .5-.1.7-.3l10-10c.4-.4.4-1 0-1.4l-4-4zM4.6 14H2v-2.6l6-6L10.6 8l-6 6zM12 6.6L9.4 4 11 2.4 13.6 5 12 6.6z" />
        </svg>
        Edit Post
      <% end %>

      <%= link_to blog_path(@blog_post), target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 rounded-xl bg-green-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-green-700" do %>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="M15 15H1V1h7V0H0v16h16V8h-1v7z" />
          <path d="M10 0v1h4.3L6.6 8.6l.7.7L15 1.7V6h1V0z" />
        </svg>
        View Live
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_320px]">
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <% if @blog_post.main_image.attached? %>
        <div class="overflow-hidden border-b border-gray-200 bg-gray-100">
          <%= image_tag @blog_post.main_image, class: "block h-72 w-full object-cover object-center md:h-96", alt: @blog_post.title %>
        </div>
      <% end %>

      <div class="p-6 md:p-8">
        <div class="prose prose-green max-w-none text-gray-700">
          <% if @blog_post.body.present? %>
            <%= @blog_post.body %>
          <% else %>
            <div class="rounded-xl border border-dashed border-gray-200 py-12 text-center text-gray-400">
              No content has been written for this post yet.
            </div>
          <% end %>
        </div>

        <% if @blog_post.gallery_images.attached? %>
          <section class="mt-10 border-t border-gray-100 pt-6">
            <h2 class="text-lg font-semibold text-gray-900">Gallery Images</h2>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
              <% @blog_post.gallery_images.attachments.first(3).each do |image| %>
                <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-100">
                  <%= image_tag image, class: "block h-44 w-full object-cover object-center", alt: "Gallery image for #{@blog_post.title}" %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </section>

    <aside class="space-y-6">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="border-b border-gray-100 pb-4 text-lg font-semibold text-gray-900">Publication Details</h3>
        <dl class="mt-5 space-y-5">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Status</dt>
            <dd class="mt-2">
              <% if @blog_post.published_at.present? && @blog_post.published_at <= Time.current %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">Published</span>
              <% elsif @blog_post.published_at.present? && @blog_post.published_at > Time.current %>
                <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">Scheduled</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">Draft</span>
              <% end %>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Author</dt>
            <dd class="mt-2 flex items-center gap-3">
              <% if @blog_post.author.present? %>
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">
                  <%= @blog_post.author.initials %>
                </div>
                <%= link_to @blog_post.author.full_name, admin_user_path(@blog_post.author), class: "text-sm font-semibold text-green-700 transition-colors hover:text-green-800" %>
              <% else %>
                <span class="text-sm text-gray-400">Unknown Author</span>
              <% end %>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Publication Date</dt>
            <dd class="mt-2 text-sm font-semibold text-gray-900">
              <%= @blog_post.published_at&.strftime("%B %d, %Y") || "Not set" %>
            </dd>
          </div>

          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Created</dt>
            <dd class="mt-2 text-sm text-gray-500"><%= time_ago_in_words(@blog_post.created_at) %> ago</dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</div>
