<div class="form-card">
  <%= form_with(model: [:admin, event], class: "directorate-form", html: { multipart: true }, data: { controller: "event-type" }) do |form| %>
    <% if event.errors.any? %>
      <div class="error-banner">
        <div class="error-icon-wrap">
          <svg class="error-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="error-body">
          <h3 class="error-title"><%= pluralize(event.errors.count, "error") %> detected</h3>
          <ul class="error-list">
            <% event.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="form-fields">
      <div class="field-group">
        <%= form.label :title, class: "field-label" %>
        <div class="field-hint">The official name or headline of this event</div>
        <%= form.text_field :title, placeholder: "e.g. National Youth Conference 2026", class: "field-input" %>
      </div>

      <div class="field-group">
        <%= form.label :description, class: "field-label" %>
        <div class="field-hint">A full description of the event — supports rich text formatting</div>
        <div class="rich-text-wrap">
          <%= form.rich_text_area :description, class: "field-richtext", style: "min-height: 200px;" %>
        </div>
      </div>

      <div class="form-row">
        <div class="field-group">
          <%= form.label :start_time, class: "field-label" %>
          <div class="field-hint">When the event begins, if this event has one central schedule</div>
          <%= form.datetime_field :start_time, class: "field-input" %>
        </div>
        <div class="field-group">
          <%= form.label :end_time, class: "field-label" %>
          <div class="field-hint">When the event concludes, if known</div>
          <%= form.datetime_field :end_time, class: "field-input" %>
        </div>
      </div>

      <div class="field-group">
        <%= form.label :location, class: "field-label" %>
        <div class="field-hint">Physical or virtual venue, if this event has one central location</div>
        <%= form.text_field :location, placeholder: "e.g. Lagos Secretariat, Ikeja", class: "field-input" %>
      </div>

      <div class="form-row">
        <% if current_user.super_admin? %>
          <div class="field-group">
            <%= form.label :state_id, "State (Optional)", class: "field-label" %>
            <div class="field-hint">Scope to a state, or leave blank for a national event</div>
            <%= form.collection_select :state_id, State.order(:name), :id, :name,
                { include_blank: "National Event" },
                { class: "field-input field-select" } %>
          </div>
        <% end %>

        <div class="field-group">
          <%= form.label :event_type, class: "field-label" %>
          <div class="field-hint">Choose paid/free registration, or information-only when no registration is needed</div>
          <%= form.select :event_type,
              Event.event_types.keys.map { |t| [t.humanize, t] },
              {},
              class: "field-input field-select",
              data: { action: "change->event-type#togglePrice" } %>
        </div>
      </div>

      <div class="form-row" data-event-type-target="priceField">
        <div class="field-group">
          <%= form.label :price, class: "field-label" %>
          <div class="field-hint">Registration fee amount, if shown on this event page</div>
          <%= form.number_field :price, step: "0.01", placeholder: "0.00", class: "field-input" %>
        </div>
        <div class="field-group" data-event-type-target="currencyField">
          <%= form.label :currency, class: "field-label" %>
          <div class="field-hint">Currency code for the fee</div>
          <%= form.text_field :currency, class: "field-input", placeholder: "NGN" %>
        </div>
      </div>

      <div class="field-group">
        <%= form.label :image, "Event Banner / Image", class: "field-label" %>
        <div class="field-hint">Upload a banner or cover image for this event (PNG, JPG, GIF — up to 10MB)</div>
        <div class="upload-zone">
          <div class="upload-zone-inner">
            <svg class="upload-icon" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="upload-label">
              <label class="relative cursor-pointer">
                <a>Upload a file</a>
                <%= form.file_field :image, class: "sr-only" %>
              </label>
              &nbsp;or drag and drop
            </div>
            <p class="upload-hint">PNG, JPG, GIF up to 10MB</p>
          </div>
        </div>
      </div>

      <div class="checkbox-row" style="margin-bottom: 2rem;">
        <%= form.check_box :spotlight, class: "checkbox-input" %>
        <div>
          <%= form.label :spotlight, "Spotlight Event", class: "checkbox-label" %>
          <div class="checkbox-desc">Show this event in the site-wide modal (takes priority over announcements).</div>
        </div>
      </div>

      <% if event.camp_information_event? %>
        <div class="field-group">
          <div class="camp-admin-heading">
            <div>
              <h2>State Camp Details</h2>
              <p>Upload the flyer, add notes, and paste the registration link. Add an Area/location row when a state has more than one camp.</p>
            </div>
            <span><%= Event::CAMP_STATE_NAMES.size %> states/FCT</span>
          </div>

          <div class="camp-admin-save-note">
            <strong>Remember to save</strong>
            <span>After adding a flyer, notes, registration link, or Area row, click “Update Event” to publish those Camp details.</span>
          </div>

          <% camp_details_by_state = event.camp_details.group_by(&:state_name) %>
          <% states_by_name = State.includes(:areas).index_by(&:name) %>
          <% fct_state = State.includes(:areas).find_by(code: "FCT") %>
          <div class="camp-admin-editor" data-camp-admin-editor>
            <div class="camp-admin-tabs" role="tablist" aria-label="Camp state details">
              <% Event::CAMP_STATE_NAMES.each_with_index do |state_name, state_index| %>
                <% state_key = state_name.parameterize %>
                <button
                  type="button"
                  class="camp-admin-tab"
                  role="tab"
                  aria-selected="<%= state_index.zero? ? "true" : "false" %>"
                  aria-controls="camp-panel-<%= state_key %>"
                  data-camp-admin-tab="<%= state_key %>">
                  <%= state_name %>
                </button>
              <% end %>
            </div>

            <div class="camp-admin-panels">
            <% Event::CAMP_STATE_NAMES.each_with_index do |state_name, state_index| %>
              <% state_key = state_name.parameterize %>
              <% state_record = state_name == "FCT" ? fct_state : states_by_name[state_name] %>
              <% area_options = state_record&.areas&.order(:name) || [] %>
              <section
                id="camp-panel-<%= state_key %>"
                class="camp-admin-panel"
                role="tabpanel"
                data-camp-admin-panel="<%= state_key %>"
                <%= "hidden" unless state_index.zero? %>>
                <div class="camp-admin-panel__head">
                  <div>
                    <h3><%= state_name %></h3>
                    <p><%= area_options.any? ? pluralize(area_options.size, "Area") : "No Areas have been created for this state yet." %></p>
                  </div>
                  <div class="camp-admin-panel__actions">
                    <% if state_record %>
                      <%= link_to "Manage Areas", admin_state_areas_path(state_record), class: "camp-admin-manage", target: "_blank", rel: "noopener" %>
                    <% end %>
                    <button type="button" class="camp-admin-add" data-camp-add-area="<%= state_key %>">Add Area</button>
                  </div>
                </div>

                <% existing_details_for_state = camp_details_by_state[state_name] || [] %>
                <% main_camp_detail = existing_details_for_state.find { |detail| detail.area_id.blank? } || event.camp_details.build(state_name: state_name, position: state_index) %>
                <% area_camp_details = existing_details_for_state.select { |detail| detail.area_id.present? } %>
                <% details_for_state = [main_camp_detail, *area_camp_details] %>

                <div class="camp-admin-locations" data-camp-area-list="<%= state_key %>">
                  <% details_for_state.each_with_index do |camp_detail, detail_index| %>
                    <%= form.fields_for :camp_details, camp_detail, child_index: (state_index * 100 + detail_index).to_s do |camp_form| %>
                      <% main_camp_row = detail_index.zero? %>
                      <div class="camp-admin-location">
                        <%= camp_form.hidden_field :id if camp_form.object.persisted? %>
                        <%= camp_form.hidden_field :state_name %>
                        <%= camp_form.hidden_field :position %>
                        <%= camp_form.hidden_field :area_row, value: "1" unless main_camp_row %>

                        <div class="camp-admin-location__head">
                          <strong><%= main_camp_row ? "Main camp" : "Area/location #{detail_index}" %></strong>
                          <% if camp_form.object.persisted? && !main_camp_row %>
                            <label>
                              <%= camp_form.check_box :_destroy %>
                              Remove
                            </label>
                          <% end %>
                        </div>

                        <div class="camp-admin-fields">
                          <div>
                            <%= camp_form.label :area_id, "Area / Location", class: "field-label" %>
                            <% if main_camp_row %>
                              <%= camp_form.hidden_field :area_id, value: "" %>
                              <div class="camp-admin-empty-area">
                                Main Camp / Statewide
                              </div>
                            <% elsif area_options.any? %>
                              <%= camp_form.collection_select :area_id, area_options, :id, :name,
                                  { include_blank: "Choose Area" },
                                  { class: "field-input field-select" } %>
                            <% else %>
                              <%= camp_form.hidden_field :area_id %>
                              <div class="camp-admin-empty-area">
                                No Areas have been created for this state yet.
                                <% if state_record %>
                                  <%= link_to "Create Area", new_admin_state_area_path(state_record), target: "_blank", rel: "noopener" %>
                                <% end %>
                              </div>
                            <% end %>
                          </div>

                          <div>
                            <%= camp_form.label :flyer, "Flyer upload", class: "field-label" %>
                            <%= camp_form.file_field :flyer, class: "field-input" %>
                            <% if camp_form.object.flyer.attached? %>
                              <p class="camp-admin-file">Current flyer: <%= camp_form.object.flyer.filename %></p>
                            <% end %>
                          </div>

                          <div class="camp-admin-notes">
                            <%= camp_form.label :registration_link, "Registration link", class: "field-label" %>
                            <%= camp_form.url_field :registration_link, class: "field-input", placeholder: "https://example.com/register" %>
                          </div>

                          <div class="camp-admin-notes">
                            <%= camp_form.label :formatted_notes, "Notes", class: "field-label" %>
                            <div class="rich-text-wrap">
                              <%= camp_form.rich_text_area :formatted_notes, class: "field-richtext camp-admin-richtext" %>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>

                <template data-camp-area-template="<%= state_key %>">
                  <%= form.fields_for :camp_details, CampDetail.new(state_name: state_name, position: state_index), child_index: "#{state_index}000NEW_RECORD" do |camp_form| %>
                    <div class="camp-admin-location">
                      <%= camp_form.hidden_field :state_name %>
                      <%= camp_form.hidden_field :position %>
                      <%= camp_form.hidden_field :area_row, value: "1" %>

                      <div class="camp-admin-location__head">
                        <strong>New Area/location</strong>
                        <button type="button" class="camp-admin-remove-new" data-camp-remove-area>Remove</button>
                      </div>

                      <div class="camp-admin-fields">
                        <div>
                          <%= camp_form.label :area_id, "Area / Location", class: "field-label" %>
                          <% if area_options.any? %>
                            <%= camp_form.collection_select :area_id, area_options, :id, :name,
                                { include_blank: "Choose Area" },
                                { class: "field-input field-select" } %>
                          <% else %>
                            <%= camp_form.hidden_field :area_id %>
                            <div class="camp-admin-empty-area">
                              Create Areas for this state first if this camp is tied to a specific Area.
                              <% if state_record %>
                                <%= link_to "Create Area", new_admin_state_area_path(state_record), target: "_blank", rel: "noopener" %>
                              <% end %>
                            </div>
                          <% end %>
                        </div>

                        <div>
                          <%= camp_form.label :flyer, "Flyer upload", class: "field-label" %>
                          <%= camp_form.file_field :flyer, class: "field-input" %>
                        </div>

                        <div class="camp-admin-notes">
                          <%= camp_form.label :registration_link, "Registration link", class: "field-label" %>
                          <%= camp_form.url_field :registration_link, class: "field-input", placeholder: "https://example.com/register" %>
                        </div>

                        <div class="camp-admin-notes">
                          <%= camp_form.label :formatted_notes, "Notes", class: "field-label" %>
                          <div class="rich-text-wrap">
                            <%= camp_form.rich_text_area :formatted_notes, class: "field-richtext camp-admin-richtext" %>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </template>
              </section>
            <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="field-group">
          <div class="event-status-note">
            <strong>Camp details editor</strong>
            <p>Set Event Type to Information and include “Camp” in the title, then save. The dashboard will open the editable state-by-state Camp details after the event is created.</p>
          </div>
        </div>
      <% end %>

      <div class="field-group">
        <div class="event-status-note">
          <strong>Registration status is automatic</strong>
          <p>Upcoming free and paid events are open for registration. Information-only events never show registration or pricing.</p>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to admin_events_path, class: "btn-cancel" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="btn-icon">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Cancel
      <% end %>
      <%= form.submit event.new_record? ? "Create Event" : "Update Event", class: "btn-submit" %>
    </div>
  <% end %>
</div>

<style>
  .form-card { background:#fff; border-radius:16px; box-shadow:0 1px 3px rgba(0,0,0,.06),0 4px 24px rgba(0,0,0,.04); border:1px solid #f0f0f0; padding:2.5rem; font-family:'Georgia',serif; }
  .error-banner { display:flex; gap:.875rem; background:#fff5f5; border:1px solid #fecaca; border-left:4px solid #ef4444; border-radius:10px; padding:1rem 1.25rem; margin-bottom:2rem; }
  .error-icon-wrap { flex-shrink:0; padding-top:1px; }
  .error-icon { width:18px; height:18px; color:#ef4444; }
  .error-title { font-size:.8125rem; font-weight:700; color:#991b1b; margin:0 0 .375rem; letter-spacing:.01em; }
  .error-list { margin:0; padding-left:1.125rem; font-size:.8125rem; color:#b91c1c; line-height:1.6; }
  .form-fields { display:flex; flex-direction:column; gap:2rem; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  @media(max-width:540px){ .form-row { grid-template-columns:1fr; } }
  .field-group { display:flex; flex-direction:column; }
  .field-label { display:block; font-size:.6875rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#374151; margin-bottom:.375rem; }
  .field-hint { font-size:.8rem; color:#9ca3af; margin-bottom:.75rem; font-style:italic; font-family:'Georgia',serif; line-height:1.4; }
  .field-input { display:block; width:100%; padding:.75rem 1rem; background:#f9fafb; border:1.5px solid #22c55e; border-radius:10px; font-size:.9rem; color:#111827; font-family:inherit; line-height:1.5; transition:border-color .18s ease,background .18s ease,box-shadow .18s ease; box-sizing:border-box; outline:none; appearance:none; }
  .field-input::placeholder { color:#b0bec5; font-style:italic; }
  .field-input:hover { border-color:#16a34a; background:#fff; }
  .field-input:focus { background:#fff; border-color:#16a34a; box-shadow:0 0 0 4px rgba(34,197,94,.1); }
  .field-select { cursor:pointer; }
  .rich-text-wrap { border:1.5px solid #22c55e; border-radius:10px; background:#f9fafb; overflow:hidden; transition:border-color .18s ease,box-shadow .18s ease; }
  .rich-text-wrap:focus-within { border-color:#16a34a; background:#fff; box-shadow:0 0 0 4px rgba(34,197,94,.1); }
  .field-richtext { border:none !important; box-shadow:none !important; background:transparent !important; padding:.75rem 1rem; }
  .upload-zone { display:flex; justify-content:center; padding:2rem 1.5rem; border:2px dashed #22c55e; border-radius:10px; background:#f9fafb; cursor:pointer; transition:border-color .18s ease,background .18s ease; }
  .upload-zone:hover { border-color:#16a34a; background:#fff; }
  .upload-zone-inner { text-align:center; }
  .upload-icon { width:2.5rem; height:2.5rem; color:#d1d5db; margin:0 auto .75rem; }
  .upload-label { font-size:.8375rem; color:#6b7280; }
  .upload-label a { color:#16a34a; font-weight:600; text-decoration:none; cursor:pointer; }
  .upload-label a:hover { color:#15803d; }
  .upload-hint { font-size:.75rem; color:#9ca3af; margin-top:.375rem; font-style:italic; }
  .event-status-note { padding:1rem 1.25rem; background:#f0fdf4; border-radius:10px; border:1.5px solid #bbf7d0; }
  .event-status-note strong { display:block; font-size:.875rem; color:#166534; margin-bottom:.25rem; }
  .event-status-note p { font-size:.8rem; color:#15803d; font-style:italic; line-height:1.5; }
  .camp-admin-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1.25rem; background:#f0fdf4; border:1.5px solid #bbf7d0; border-radius:12px; margin-bottom:1rem; }
  .camp-admin-heading h2 { margin:0; font-size:1rem; color:#14532d; font-weight:800; }
  .camp-admin-heading p { margin:.25rem 0 0; color:#15803d; font-size:.82rem; line-height:1.5; font-style:italic; }
  .camp-admin-heading span { flex-shrink:0; display:inline-flex; align-items:center; border-radius:999px; background:#fff; border:1px solid #bbf7d0; color:#166534; padding:.35rem .7rem; font-size:.72rem; font-weight:800; }
  .camp-admin-save-note { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin:0 0 1rem; padding:.85rem 1rem; border:1px solid #facc15; border-radius:10px; color:#854d0e; background:#fefce8; font-size:.82rem; }
  .camp-admin-save-note strong { font-weight:900; }
  .camp-admin-editor { border:1px solid #e5e7eb; border-radius:12px; background:#fff; overflow:hidden; }
  .camp-admin-tabs { display:flex; gap:.45rem; padding:.75rem; overflow-x:auto; border-bottom:1px solid #e5e7eb; background:#f9fafb; }
  .camp-admin-tab { flex:0 0 auto; border:1px solid #e5e7eb; border-radius:999px; padding:.55rem .8rem; color:#374151; background:#fff; font:inherit; font-size:.78rem; font-weight:800; cursor:pointer; }
  .camp-admin-tab[aria-selected="true"] { color:#fff; background:#16a34a; border-color:#16a34a; box-shadow:0 8px 18px rgba(22,163,74,.18); }
  .camp-admin-tab:focus-visible { outline:3px solid rgba(34,197,94,.22); outline-offset:2px; }
  .camp-admin-panels { padding:1rem; }
  .camp-admin-panel__head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding-bottom:1rem; border-bottom:1px solid #eef2f7; margin-bottom:1rem; }
  .camp-admin-panel__head h3 { margin:0; font-size:1.1rem; color:#111827; font-weight:900; }
  .camp-admin-panel__head p { margin:.25rem 0 0; color:#6b7280; font-size:.82rem; font-style:italic; }
  .camp-admin-panel__actions { display:flex; align-items:center; justify-content:flex-end; gap:.65rem; flex-wrap:wrap; }
  .camp-admin-manage { border:1px solid #e5e7eb; border-radius:9px; padding:.65rem .9rem; color:#374151; background:#fff; font-size:.8rem; font-weight:800; text-decoration:none; }
  .camp-admin-manage:hover { background:#f9fafb; border-color:#bbf7d0; color:#15803d; }
  .camp-admin-add { flex-shrink:0; border:0; border-radius:9px; padding:.7rem 1rem; color:#fff; background:#16a34a; font:inherit; font-size:.8rem; font-weight:900; cursor:pointer; box-shadow:0 8px 18px rgba(22,163,74,.18); }
  .camp-admin-add:hover { background:#15803d; }
  .camp-admin-locations { display:grid; gap:1rem; }
  .camp-admin-location { border:1px solid #eef2f7; border-radius:10px; padding:1rem; background:#fbfdff; }
  .camp-admin-location__head { display:flex; align-items:center; justify-content:space-between; gap:.75rem; margin-bottom:1rem; }
  .camp-admin-location__head strong { color:#14532d; font-size:.85rem; text-transform:uppercase; letter-spacing:.06em; }
  .camp-admin-location__head label { display:inline-flex; align-items:center; gap:.35rem; color:#b91c1c; font-size:.78rem; font-weight:700; cursor:pointer; }
  .camp-admin-remove-new { border:0; background:transparent; color:#b91c1c; font:inherit; font-size:.78rem; font-weight:800; cursor:pointer; }
  .camp-admin-fields { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  @media(max-width:700px){ .camp-admin-fields { grid-template-columns:1fr; } }
  .camp-admin-notes { grid-column:1 / -1; }
  .camp-admin-richtext { min-height:150px; }
  .camp-admin-empty-area { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; min-height:46px; border:1.5px dashed #d1d5db; border-radius:10px; padding:.75rem 1rem; color:#6b7280; background:#fff; font-size:.8rem; font-style:italic; }
  .camp-admin-empty-area a { color:#15803d; font-weight:800; font-style:normal; text-decoration:none; }
  .camp-admin-file { margin:.45rem 0 0; color:#15803d; font-size:.75rem; font-style:italic; overflow-wrap:anywhere; }
  .checkbox-row { display:flex; align-items:flex-start; gap:.875rem; padding:1rem 1.25rem; background:#f9fafb; border-radius:10px; border:1.5px solid #e5e7eb; transition:border-color .18s ease,background .18s ease; }
