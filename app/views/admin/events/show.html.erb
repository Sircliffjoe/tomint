<% content_for :title, @event.title %>

<div class="px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 sm:flex sm:items-start sm:justify-between">
    <div>
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <%= link_to "Events", admin_events_path, class: "hover:text-green-600 transition-colors" %>
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <span class="font-medium text-gray-700">Details</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= @event.title %></h1>
        <% if @event.spotlight? %>
          <span class="inline-flex items-center rounded-full bg-yellow-50 px-3 py-1 text-xs font-semibold text-yellow-700 ring-1 ring-inset ring-yellow-600/20">Spotlight</span>
        <% end %>
        <% if @event.registration_open? %>
          <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700 ring-1 ring-inset ring-green-600/20">Registration open</span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 ring-1 ring-inset ring-red-600/20">Registration closed</span>
        <% end %>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-3 sm:mt-0 sm:ml-6">
      <%= link_to "View Live", event_path(@event), target: "_blank", class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <%= link_to "Edit Event", edit_admin_event_path(@event), class: "rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" %>
      <%= button_to "Delete Event", admin_event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this event?" }, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 border-0 cursor-pointer" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-3">
    <div class="xl:col-span-2 space-y-8">
      <section class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200">
        <% if @event.image.attached? %>
          <div class="h-80 bg-gray-100">
            <%= image_tag @event.image, class: "h-full w-full object-cover", alt: @event.title %>
          </div>
        <% else %>
          <div class="flex h-80 items-center justify-center bg-gray-50">
            <div class="text-center">
              <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5A2.25 2.25 0 015.25 5.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75" />
              </svg>
              <p class="mt-3 text-sm font-medium text-gray-500">No event image uploaded</p>
            </div>
          </div>
        <% end %>

        <div class="p-6 sm:p-8">
          <div class="border-b border-gray-100 pb-5">
            <h2 class="text-base font-semibold text-gray-900">Description</h2>
            <p class="mt-1 text-sm text-gray-500">Public-facing event information.</p>
          </div>

          <div class="prose prose-sm prose-green mt-6 max-w-none text-gray-600" style="line-height: 1.8;">
            <% if @event.description.present? %>
              <%= @event.description %>
            <% else %>
              <p>No description provided.</p>
            <% end %>
          </div>
        </div>
      </section>

      <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">
        <div class="border-b border-gray-100 pb-5">
          <h2 class="text-base font-semibold text-gray-900">Event Schedule</h2>
          <p class="mt-1 text-sm text-gray-500">Timing and location details shown to visitors.</p>
        </div>

        <dl class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="rounded-lg border border-gray-200 p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Starts</dt>
            <dd class="mt-2 text-sm font-semibold text-gray-900"><%= @event.start_time&.strftime("%A, %B %d, %Y") || "Not set" %></dd>
            <dd class="mt-1 text-sm text-gray-500"><%= @event.start_time&.strftime("%I:%M %p") || "Time not set" %></dd>
          </div>
          <div class="rounded-lg border border-gray-200 p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Ends</dt>
            <dd class="mt-2 text-sm font-semibold text-gray-900"><%= @event.end_time&.strftime("%A, %B %d, %Y") || "Not set" %></dd>
            <dd class="mt-1 text-sm text-gray-500"><%= @event.end_time&.strftime("%I:%M %p") || "Time not set" %></dd>
          </div>
          <div class="rounded-lg border border-gray-200 p-4 sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Location</dt>
            <dd class="mt-2 text-sm font-semibold text-gray-900"><%= @event.location.presence || "TBD" %></dd>
            <dd class="mt-1 text-sm text-gray-500"><%= @event.state&.name || "National / Online" %></dd>
          </div>
        </dl>
      </section>
    </div>

    <aside class="space-y-8">
      <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-200">
        <div class="border-b border-gray-100 px-6 py-5">
          <h2 class="text-base font-semibold text-gray-900">Management</h2>
          <p class="mt-1 text-sm text-gray-500">Quick actions for this event.</p>
        </div>

        <div class="space-y-3 px-6 py-5">
          <%= link_to "Edit Event", edit_admin_event_path(@event), class: "block w-full rounded-lg bg-green-600 px-4 py-3 text-center text-sm font-semibold text-white shadow-sm hover:bg-green-500" %>
          <%= button_to "Delete Event", admin_event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this event?" }, class: "block w-full rounded-lg bg-red-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-red-500 border-0 cursor-pointer" %>
          <%= link_to "Back to Events", admin_events_path, class: "block w-full rounded-lg bg-white px-4 py-3 text-center text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        </div>
      </section>

      <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-200">
        <div class="border-b border-gray-100 px-6 py-5">
          <h2 class="text-base font-semibold text-gray-900">Registration</h2>
        </div>

        <dl class="divide-y divide-gray-100">
          <div class="flex items-center justify-between px-6 py-4">
            <dt class="text-sm text-gray-500">Type</dt>
            <dd class="text-sm font-semibold text-gray-900"><%= @event.event_type&.titleize || "Free" %></dd>
          </div>
          <div class="flex items-center justify-between px-6 py-4">
            <dt class="text-sm text-gray-500">Price</dt>
            <dd class="text-sm font-semibold text-gray-900">
              <% if @event.paid? %>
                <%= @event.currency %> <%= number_with_delimiter(@event.price.to_i) %>
              <% else %>
                Free
              <% end %>
            </dd>
          </div>
          <div class="flex items-center justify-between px-6 py-4">
            <dt class="text-sm text-gray-500">Status</dt>
            <dd>
              <% if @event.registration_open? %>
                <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-semibold text-green-700 ring-1 ring-inset ring-green-600/20">Open</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 ring-1 ring-inset ring-red-600/20">Closed</span>
              <% end %>
            </dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</div>
