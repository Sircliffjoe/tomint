<% content_for :title, "Reset Password - TOM Int." %>

<section class="min-h-screen bg-gradient-to-br from-stone-100 via-white to-green-50 px-6 py-20 lg:px-8">
  <div class="mx-auto flex min-h-[calc(100vh-10rem)] max-w-6xl items-center justify-center">
    <div class="grid w-full overflow-hidden rounded-3xl bg-white shadow-2xl shadow-green-950/10 ring-1 ring-green-900/10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="hidden bg-green-950 p-10 text-white lg:flex lg:flex-col lg:justify-between">
        <div>
          <%= image_tag "logo-2.png", alt: "TOM Int.", class: "h-14 w-auto rounded bg-white/95 p-2" %>
          <p class="mt-10 text-sm font-semibold uppercase tracking-[0.3em] text-green-200">Internal Access</p>
          <h1 class="mt-4 text-4xl font-black leading-tight">Reset your platform password.</h1>
          <p class="mt-5 text-base leading-7 text-green-100">Use this page only if you already have a TOM platform account created by the Super Admin.</p>
        </div>
        <p class="text-sm text-green-200">For account access issues, contact your administrator.</p>
      </div>

      <div class="p-8 sm:p-12">
        <div class="mx-auto max-w-md">
          <div class="lg:hidden">
            <%= image_tag "logo-2.png", alt: "TOM Int.", class: "h-14 w-auto" %>
          </div>

          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-green-700">Password Reset</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-gray-900">Choose a new password</h2>
          <p class="mt-3 text-sm leading-6 text-gray-500">Enter the email address on your account, then set your new password. No reset email will be sent.</p>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div>
              <%= f.label :email, class: "block text-sm font-semibold text-gray-900" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-xl border-0 px-4 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-green-700" %>
            </div>

            <div>
              <%= f.label :password, "New password", class: "block text-sm font-semibold text-gray-900" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "mt-2 block w-full rounded-xl border-0 px-4 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-green-700" %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-semibold text-gray-900" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 block w-full rounded-xl border-0 px-4 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-green-700" %>
            </div>

            <%= f.submit "Save New Password", class: "flex w-full justify-center rounded-full bg-green-800 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-green-900/20 hover:bg-green-900 cursor-pointer border-0" %>
          <% end %>

          <div class="mt-6 flex items-center justify-between text-sm">
            <%= link_to "Back to login", new_user_session_path, class: "font-semibold text-green-700 hover:text-green-900" %>
            <%= link_to "Contact admin", contact_path, class: "font-semibold text-gray-500 hover:text-gray-900" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
