<% content_for :title, "TOM ASK — You can ask. We will listen." %>

<section class="tom-page-hero" style="background: radial-gradient(circle at 10% 20%, rgba(163, 230, 53, 0.22), transparent 30rem), radial-gradient(circle at 90% 15%, rgba(56, 189, 248, 0.18), transparent 28rem), #052e16;">
  <div class="tom-container px-4 sm:px-6 lg:px-8">
    <div class="tom-ask-hero-panel py-12" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-lime); font-size: 0.95rem; letter-spacing: 0.1em; text-transform: uppercase;">
        Teen Engagement &amp; Q&amp;A
      </span>
      <h1 class="font-extrabold tracking-tight mt-3 mb-4 font-heading">
        TOM ASK
      </h1>
      <p class="text-xl sm:text-2xl font-semibold text-lime-200 mb-6">
        <%= SystemSetting.ask_headline %>
      </p>
      <p class="text-base sm:text-lg text-emerald-100/90 max-w-2xl mx-auto leading-relaxed">
        <%= SystemSetting.ask_intro_text %>
      </p>

      <div class="tom-ask-hero-actions">
        <a href="#ask-form-section" class="tom-ask-hero-btn tom-ask-hero-btn-primary">
          Ask a Question
        </a>
        <a href="<%= ask_questions_path %>" class="tom-ask-hero-btn tom-ask-hero-btn-secondary">
          Browse Answered Q&amp;A
        </a>
      </div>

      <% if @active_live_sessions.any? %>
        <div class="mt-8 p-4 rounded-2xl bg-emerald-900/60 border border-lime-400/40 backdrop-blur-sm max-w-xl mx-auto flex items-center justify-between gap-4 text-left">
          <div class="flex items-center gap-3">
            <span class="flex h-3 w-3 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-lime-500"></span>
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-lime-300">Live Q&amp;A Session Active</p>
              <p class="text-sm font-semibold text-white truncate"><%= @active_live_sessions.first.title %></p>
            </div>
          </div>
          <%= link_to "Join Live", ask_live_session_path(@active_live_sessions.first), class: "px-4 py-2 rounded-full bg-lime-400 text-emerald-950 text-xs font-bold hover:bg-lime-300 transition-all shrink-0" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Main Question Form Section -->
<section id="ask-form-section" class="py-12 sm:py-16 bg-stone-50">
  <div class="tom-container max-w-3xl">
    <div id="ask-form-container" class="bg-white rounded-3xl shadow-xl border border-stone-200/80 p-6 sm:p-10 transition-all">
      <%= render "ask/home/form", question: @question, categories: @categories %>
    </div>

    <!-- Question Status Check Box -->
    <div class="mt-8 bg-white/70 backdrop-blur-sm rounded-2xl border border-stone-200 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h4 class="text-sm font-bold text-stone-800">Already asked a question?</h4>
        <p class="text-xs text-stone-500">Enter your Reference Code to check if TOM staff has published an answer.</p>
      </div>
      <%= form_with url: ask_status_check_path, method: :get, class: "flex items-center gap-2 w-full sm:w-auto" do |f| %>
        <%= f.text_field :reference, placeholder: "e.g. ASK-A1B2C3", class: "px-3 py-2 text-xs uppercase font-mono rounded-lg border border-stone-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none w-full sm:w-36" %>
        <%= f.submit "Check", class: "px-4 py-2 text-xs font-bold rounded-lg bg-emerald-700 text-white hover:bg-emerald-800 transition-all cursor-pointer shrink-0" %>
      <% end %>
    </div>
  </div>
</section>

<!-- Answered Questions Preview Section -->
<section class="py-14 bg-white border-t border-stone-200">
  <div class="tom-container" style="margin-top:60px;">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <span class="tom-eyebrow text-emerald-700">Public Q&amp;A Library</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 mt-1">Recently Answered Questions</h2>
      </div>
      <%= link_to "View all questions &rarr;".html_safe, ask_questions_path, class: "text-emerald-700 font-bold hover:text-emerald-800 transition-colors" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" style="margin-bottom:60px;">
      <% if @recent_answered.any? %>
        <% @recent_answered.each do |q| %>
          <article class="p-6 rounded-2xl bg-stone-50 border border-stone-200 hover:border-emerald-300 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <% if q.ask_category %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= q.ask_category.color_badge_class %>">
                    <%= q.ask_category.name %>
                  </span>
                <% else %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">General</span>
                <% end %>
                <span class="text-xs text-stone-400 font-mono"><%= q.public_reference %></span>
              </div>
              <h3 class="text-base font-bold text-stone-900 mb-2 hover:text-emerald-700 transition-colors">
                <%= link_to q.display_body.truncate(110), ask_question_path(q) %>
              </h3>
              <% if q.published_response %>
                <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 leading-relaxed">
                  <%= q.published_response.body.truncate(180) %>
                </p>
              <% end %>
            </div>
            <div class="mt-4 pt-4 border-t border-stone-200/60 flex items-center justify-between text-xs text-stone-400">
              <span>Answered <%= time_ago_in_words(q.answered_at || q.updated_at) %> ago</span>
              <%= link_to "Read Full Answer &rarr;".html_safe, ask_question_path(q), class: "font-semibold text-emerald-700 hover:underline" %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="col-span-2 p-8 text-center bg-stone-50 rounded-2xl border border-stone-200 text-stone-500">
          <p>No questions published yet. Be the first to ask!</p>
        </div>
      <% end %>
    </div>
  </div>
</section>
