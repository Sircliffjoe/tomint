<%# Update Full Page Form (when on /ask) %>
<%= turbo_stream.replace "ask-form-container" do %>
  <div class="text-center py-8 px-4 space-y-6">
    <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto ring-8 ring-emerald-50">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div>
      <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200 uppercase tracking-wider">
        Submission Received
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 mt-2">Thank you. We have received your question.</h2>
      <p class="text-sm text-stone-600 max-w-md mx-auto mt-2 leading-relaxed">
        Our team will review your question with care and discretion. You can save your Reference Code below to track its progress.
      </p>
    </div>

    <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200 max-w-sm mx-auto">
      <p class="text-xs text-stone-500 uppercase tracking-wider font-semibold">Your Reference Code</p>
      <p class="text-2xl font-black font-mono text-emerald-800 tracking-wider mt-1"><%= @question.public_reference %></p>
      <p class="text-[11px] text-stone-400 mt-1">Keep this code to check your question later.</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <%= link_to "Ask Another Question", ask_root_path, class: "px-6 py-2.5 rounded-full bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 transition-all shadow" %>
      <%= link_to "Browse Answered Q&A", ask_questions_path, class: "px-6 py-2.5 rounded-full border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100 transition-all" %>
    </div>
  </div>
<% end %>

<%# Update Floating Widget Body (across the site) %>
<%= turbo_stream.replace "floating-ask-widget-body" do %>
  <div id="floating-ask-widget-body" class="p-5 text-center space-y-3.5 bg-stone-50/80">
    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto ring-4 ring-emerald-50">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div>
      <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase tracking-wider">
        Sent Successfully
      </span>
      <h3 class="text-base font-bold text-stone-900 mt-1.5 font-heading">Question Received!</h3>
      <p class="text-xs text-stone-600 mt-1 leading-relaxed">
        We've received your question. Our mentors will review it with care and confidentiality.
      </p>
    </div>

    <div class="p-3 rounded-xl bg-white border border-emerald-200/80 shadow-sm">
      <p class="text-[10px] text-stone-500 uppercase tracking-wider font-semibold">Your Tracking Code</p>
      <p class="text-xl font-black font-mono text-emerald-900 tracking-wider mt-0.5"><%= @question.public_reference %></p>
      <p class="text-[10px] text-stone-400 mt-0.5">Save this code to check on your answer</p>
    </div>

    <div class="space-y-2 pt-1">
      <%= link_to ask_check_status_path(reference: @question.public_reference), class: "block w-full py-2 px-3 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-800 transition-all shadow-sm text-center" do %>
        Check Status Now &rarr;
      <% end %>
      <%= link_to "Ask Another Question", ask_root_path, class: "block w-full py-2 px-3 rounded-xl border border-stone-200 bg-white text-stone-700 font-semibold text-xs hover:bg-stone-100 transition-all text-center" %>
    </div>
  </div>
<% end %>

<%# Global Toast Alert at Top-Right %>
<%= turbo_stream.prepend "global-flash-container" do %>
  <div class="flash-alert fixed top-20 right-5 z-50 p-4 text-emerald-900 bg-emerald-50 rounded-xl shadow-xl border border-emerald-200 flex items-center gap-3 animate-in fade-in duration-300" role="alert" style="transition: opacity 0.5s ease;">
    <div class="w-8 h-8 rounded-full bg-emerald-200 text-emerald-800 flex items-center justify-center shrink-0 font-bold">
      &#10003;
    </div>
    <div>
      <p class="text-xs font-bold">Question Sent Anonymously!</p>
      <p class="text-[11px] text-emerald-700 font-mono">Reference: <%= @question.public_reference %></p>
    </div>
  </div>
<% end %>
