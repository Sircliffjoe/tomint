<% content_for :title, "TOM ASK LIVE — Real-Time Q&A" %>

<section class="tom-page-hero" style="background: radial-gradient(circle at 20% 30%, rgba(163, 230, 53, 0.22), transparent 26rem), #052e16;">
  <div class="tom-container px-4 sm:px-6 lg:px-8">
    <div class="tom-ask-hero-panel py-12" data-reveal>
      <span class="tom-eyebrow" style="color:var(--tom-lime);">Live Q&amp;A Sessions</span>
      <h1 class="font-extrabold tracking-tight mt-2 mb-4 font-heading">
        TOM ASK LIVE
      </h1>
      <p class="text-base sm:text-lg text-emerald-100/90 max-w-lg mx-auto">
        Join live interactive Q&amp;A during TOM camps, conferences, youth meetings, and seminars.
      </p>

      <!-- Enter Code Box -->
      <div class="mt-8 bg-white/10 backdrop-blur-md rounded-3xl border border-white/20 p-6 max-w-md mx-auto shadow-2xl">
        <h3 class="text-xs font-bold text-lime-300 uppercase tracking-wider mb-2">Have a 6-Character Session Code?</h3>
        <%= form_with url: ask_live_index_path, method: :get, class: "flex items-center gap-2" do |f| %>
          <%= f.text_field :code,
            placeholder: "e.g. TOM782",
            maxlength: 12,
            required: true,
            class: "flex-1 px-4 py-3 text-center text-lg font-black font-mono uppercase tracking-widest rounded-xl bg-white text-emerald-950 placeholder:text-stone-400 focus:outline-none focus:ring-4 focus:ring-lime-300" %>
          <%= f.submit "Join", class: "px-6 py-3 rounded-xl bg-lime-400 text-emerald-950 font-extrabold text-sm hover:bg-lime-300 transition-all cursor-pointer shadow" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-stone-50 min-h-[50vh]">
  <div class="tom-container max-w-4xl">
    <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-6">Active Live Sessions</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% if @active_sessions.any? %>
        <% @active_sessions.each do |session| %>
          <div class="p-6 rounded-3xl bg-white border border-stone-200/90 shadow-sm hover:shadow-lg hover:border-emerald-400 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= session.status_badge_class %>">
                  <%= session.status.upcase %>
                </span>
                <span class="text-xs font-mono font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  CODE: <%= session.access_code %>
                </span>
              </div>
              <h3 class="text-lg font-bold text-stone-900 mb-2">
                <%= session.title %>
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 line-clamp-2">
                <%= session.description.presence || "Join this live session to ask questions and upvote your favorite topics." %>
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between">
              <span class="text-xs text-stone-400">
                <%= session.ask_questions.count %> questions &bull; <%= session.voting_enabled? ? "Voting active" : "Q&A only" %>
              </span>
              <%= link_to "Enter Session &rarr;".html_safe, ask_live_session_path(session), class: "px-4 py-2 rounded-full bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 transition-all shadow" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="col-span-2 py-16 text-center bg-white rounded-3xl border border-stone-200 space-y-3">
          <div class="w-12 h-12 rounded-full bg-stone-100 text-stone-400 flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-stone-800">No Live Sessions Right Now</h3>
          <p class="text-xs text-stone-500 max-w-sm mx-auto">
            There are currently no active live Q&amp;A sessions. You can ask anytime via our general question box or browse previously answered questions.
          </p>
          <div class="pt-2 flex justify-center gap-3">
            <%= link_to "Ask a Question", ask_root_path, class: "px-5 py-2 rounded-full bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 transition-all" %>
            <%= link_to "Browse Q&A", ask_questions_path, class: "px-5 py-2 rounded-full border border-stone-300 text-stone-700 text-xs font-semibold hover:bg-stone-100 transition-all" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
