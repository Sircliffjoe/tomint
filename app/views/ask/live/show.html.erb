<% content_for :title, "#{@live_session.title} — TOM ASK LIVE" %>

<%= turbo_stream_from "live_session_#{@live_session.id}" %>

<section class="py-8 sm:py-12 bg-stone-50 min-h-screen" data-controller="ask-live">
  <div class="tom-container max-w-3xl">
    <!-- Session Header Card -->
    <div class="bg-gradient-to-br from-emerald-950 to-emerald-900 rounded-3xl shadow-xl p-6 sm:p-8 text-white mb-6 relative overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="flex h-2.5 w-2.5 relative">
              <% if @live_session.active? %>
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-lime-500"></span>
              <% else %>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400"></span>
              <% end %>
            </span>
            <span class="text-xs font-bold uppercase tracking-wider text-lime-300">
              TOM ASK LIVE &bull; <%= @live_session.status.upcase %>
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1 font-heading">
            <%= @live_session.title %>
          </h1>
          <% if @live_session.description.present? %>
            <p class="text-xs sm:text-sm text-emerald-100/80 mt-1 max-w-xl">
              <%= @live_session.description %>
            </p>
          <% end %>
        </div>

        <div class="flex items-center gap-2">
          <div class="text-right">
            <span class="text-[10px] uppercase font-bold text-emerald-300 block">Session Code</span>
            <span class="text-lg font-black font-mono text-white bg-white/10 px-3 py-1 rounded-lg border border-white/20">
              <%= @live_session.access_code %>
            </span>
          </div>
          <button type="button"
                  data-action="click->ask-live#copyLink"
                  data-url="<%= ask_live_session_url(@live_session) %>"
                  title="Copy session link"
                  class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer border border-white/15">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Copy notification toast -->
      <div data-ask-live-target="copyNotification" class="hidden absolute top-3 right-3 px-3 py-1 rounded-lg bg-lime-400 text-emerald-950 font-bold text-xs shadow-lg">
        Link copied to clipboard!
      </div>
    </div>

    <!-- Pinned Spotlight Question (If any) -->
    <div id="live-spotlight-banner">
      <% if @live_session.current_question %>
        <div class="mb-6 p-5 rounded-2xl bg-amber-500 text-stone-950 font-semibold shadow-lg border-2 border-amber-300 flex items-start gap-3">
          <span class="px-2 py-0.5 rounded bg-stone-950 text-amber-300 text-[10px] font-black uppercase tracking-wider shrink-0 mt-0.5">
            NOW ANSWERING
          </span>
          <div class="flex-1">
            <p class="text-base sm:text-lg font-bold leading-snug">
              "<%= @live_session.current_question.display_body %>"
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Submit Live Question Box -->
    <% if @live_session.accepting_questions? %>
      <div class="bg-white rounded-3xl shadow-md border border-stone-200 p-5 sm:p-6 mb-8">
        <h2 class="text-sm font-bold text-stone-900 mb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Ask a Question in this Session
        </h2>

        <div id="live-form-feedback"></div>

        <%= form_with model: @new_question, url: ask_live_create_question_path(@live_session), class: "space-y-3" do |f| %>
          <!-- Anti-spam Honeypot -->
          <div style="display:none !important;" aria-hidden="true">
            <input type="text" name="website_hp" tabindex="-1" autocomplete="off" />
          </div>

          <div class="relative">
            <%= f.text_area :body,
              rows: 3,
              required: true,
              maxlength: 500,
              placeholder: "Type your question here...",
              class: "w-full p-3.5 rounded-2xl border border-stone-300 text-stone-900 placeholder:text-stone-400 text-sm focus:ring-4 focus:ring-emerald-100 focus:border-emerald-600 focus:outline-none transition-all resize-none",
              data: {
                ask_live_target: "input",
                action: "input->ask-live#updateCharCount"
              } %>
          </div>

          <div class="flex items-center justify-between">
            <span data-ask-live-target="charCount" class="text-xs text-stone-400">0 / 500</span>
            <%= f.submit "Send Question",
              data: { ask_live_target: "submitBtn" },
              class: "px-6 py-2.5 rounded-full bg-emerald-700 text-white font-bold text-xs sm:text-sm hover:bg-emerald-800 transition-all shadow cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-amber-50 rounded-2xl border border-amber-200 p-4 text-center text-xs text-amber-900 font-medium mb-8">
        This session is currently not accepting new questions. You can still upvote existing questions below!
      </div>
    <% end %>

    <!-- Questions Feed Header -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-stone-900 flex items-center gap-2">
        <span>Questions</span>
        <span class="text-xs font-semibold text-stone-400">(Live Updates)</span>
      </h2>
      <span class="text-xs text-stone-500 font-medium">
        <%= @live_session.voting_enabled? ? "Tap ▲ to upvote" : "" %>
      </span>
    </div>

    <!-- Live Questions List Stream -->
    <div id="live-questions-list" class="space-y-4">
      <% if @questions.any? %>
        <% @questions.each do |q| %>
          <%= render "ask/live/question_card", question: q, live_session: @live_session, voted: @voted_question_ids.include?(q.id) %>
        <% end %>
      <% else %>
        <div id="empty-live-state" class="py-12 text-center bg-white rounded-3xl border border-stone-200 text-stone-400 text-xs">
          No questions approved yet. Be the first to ask!
        </div>
      <% end %>
    </div>
  </div>
</section>
