<% content_for :title, "#{@question.display_body.truncate(60)} — TOM ASK" %>

<section class="py-12 bg-stone-50 min-h-[80vh]">
  <div class="tom-container max-w-4xl">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex items-center justify-between gap-4 mb-6">
      <%= link_to "&larr; Back to Q&A Library".html_safe, ask_questions_path, class: "text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors" %>
      <div class="flex items-center gap-2">
        <% if @question.ask_category %>
          <span class="px-3 py-1 rounded-full text-xs font-semibold <%= @question.ask_category.color_badge_class %>">
            <%= @question.ask_category.name %>
          </span>
        <% end %>
        <span class="text-xs text-stone-400 font-mono"><%= @question.public_reference %></span>
      </div>
    </div>

    <!-- Question Card -->
    <div class="bg-white rounded-3xl shadow-md border border-stone-200 p-6 sm:p-10 mb-6">
      <div class="flex items-center gap-2 text-xs font-bold text-stone-400 uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Teenager Asked
      </div>

      <h1 class="tom-ask-question-heading">
        &ldquo;<%= @question.display_body %>&rdquo;
      </h1>
      
      <p class="text-xs text-stone-400 mt-5">
        Submitted anonymously &bull; Answered <%= @question.answered_at ? @question.answered_at.strftime("%B %d, %Y") : "Recently" %>
      </p>
    </div>

    <!-- Official Answer Card -->
    <div class="bg-gradient-to-br from-emerald-950 to-emerald-900 rounded-3xl shadow-xl p-6 sm:p-10 text-white mb-10 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-lime-400/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="flex items-center justify-between border-b border-white/15 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <div>
            <h2 class="text-sm sm:text-base font-bold" style="color: #fff;">TOM Response</h2>
            <p class="text-xs text-white">Teenagers' Outreach Ministries Official Answer</p>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-white/10 text-[11px] font-semibold text-lime-300 border border-white/15">
          Approved
        </span>
      </div>

      <div class="prose prose-invert max-w-none text-emerald-50 text-base sm:text-lg leading-relaxed whitespace-pre-line">
        <%= @published_response&.body || "This question has been approved for publication." %>
      </div>

      <div class="mt-8 pt-6 border-t border-white/15 flex flex-wrap items-center justify-between text-xs text-emerald-200/70 gap-4">
        <p>1 Timothy 4:12 &bull; "Let no man despise your youth, but be an example..."</p>
        <%= link_to "Ask your own question &rarr;".html_safe, ask_root_path, class: "px-4 py-2 rounded-full bg-lime-400 text-emerald-950 font-bold hover:bg-lime-300 transition-all shadow" %>
      </div>
    </div>

    <!-- Related Questions -->
    <% if @related_questions.any? %>
      <div class="mt-12">
        <h3 class="text-lg font-bold text-stone-900 mb-4">Related Questions in <%= @question.ask_category&.name || "Library" %></h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @related_questions.each do |rq| %>
            <%= link_to ask_question_path(rq), class: "p-4 rounded-2xl bg-white border border-stone-200 hover:border-emerald-400 hover:shadow transition-all block group" do %>
              <span class="text-xs text-stone-400 font-mono"><%= rq.public_reference %></span>
              <p class="text-sm font-bold text-stone-800 group-hover:text-emerald-700 transition-colors mt-1 line-clamp-2">
                <%= rq.display_body %>
              </p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
