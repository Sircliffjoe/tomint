<div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="px-4 py-3 sm:px-6">
    <h3 class="text-2xl font-bold leading-6 text-gray-900">Edit Profile</h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Update your personal information and profile picture.</p>
  </div>

  <div class="mt-6 border-t border-gray-100">
    <%= form_with(model: @user, url: profile_path, method: :patch, local: true, multipart: true, class: "space-y-8 divide-y divide-gray-200") do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-md bg-red-50 p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800"><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc space-y-1 pl-5">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="pt-8">
        <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-6 sm:gap-x-4">
          <% if @user.must_change_password? %>
            <div class="sm:col-span-6 rounded-md bg-yellow-50 p-4 text-sm text-yellow-800">
              You are using a temporary password. Change it before continuing.
            </div>
          <% end %>

          <!-- Avatar Upload -->
          <div class="sm:col-span-6">
            <label for="avatar" class="block text-sm font-medium text-gray-700">Profile picture</label>
            <div class="mt-2 flex items-center gap-x-3">
              <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar, class: "h-16 w-16 rounded-full object-cover ring-2 ring-white shadow", data: { avatar_preview: true } %>
              <% else %>
                <div class="h-16 w-16 rounded-full bg-gray-100 flex items-center justify-center" data-avatar-fallback>
                  <svg class="h-7 w-7 text-gray-300" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12c0 2.671 1.073 5.093 2.815 6.866a.75.75 0 001.196-.06l1.293-2.155a.75.75 0 011.23-.035 7.243 7.243 0 0010.517 0 .75.75 0 011.23.035l1.293 2.155a.75.75 0 001.196.06zM15.75 9a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" clip-rule="evenodd" />
                  </svg>
                </div>
              <% end %>
              <%= image_tag "", class: "hidden h-16 w-16 rounded-full object-cover ring-2 ring-white shadow", data: { avatar_preview: true } unless @user.avatar.attached? %>
              <div class="flex-1">
                <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp,image/gif", data: { avatar_input: true }, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
                <p class="mt-2 text-xs text-gray-500">Choose an image to preview it before saving.</p>
              </div>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :first_name, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= f.text_field :first_name, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :last_name, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= f.text_field :last_name, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-8">
        <h3 class="text-base font-semibold leading-6 text-gray-900">Change Password</h3>
        <p class="mt-1 text-sm text-gray-500">Enter your current password and choose a new password.</p>

        <div class="mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-6 sm:gap-x-4">
          <div class="sm:col-span-6" data-controller="password-visibility">
            <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative">
              <%= f.password_field :current_password, autocomplete: "current-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm pr-10" %>
              <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Toggle password visibility">
                <svg data-password-visibility-target="eyeIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                <svg data-password-visibility-target="eyeSlashIcon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
              </button>
            </div>
          </div>

          <div class="sm:col-span-3" data-controller="password-visibility">
            <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative">
              <%= f.password_field :password, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm pr-10" %>
              <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Toggle password visibility">
                <svg data-password-visibility-target="eyeIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                <svg data-password-visibility-target="eyeSlashIcon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
              </button>
            </div>
          </div>

          <div class="sm:col-span-3" data-controller="password-visibility">
            <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 relative">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm pr-10" %>
              <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Toggle password visibility">
                <svg data-password-visibility-target="eyeIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                <svg data-password-visibility-target="eyeSlashIcon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-5 pb-10">
        <div class="flex justify-end gap-x-3">
          <%= link_to "Cancel", profile_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          <%= f.submit "Save Changes", class: "inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    function initAvatarPreview() {
      var input = document.querySelector("[data-avatar-input]");
      var preview = document.querySelector("[data-avatar-preview]");
      var fallback = document.querySelector("[data-avatar-fallback]");
      if (!input || !preview) return;
      if (input.dataset.previewBound) return;
      input.dataset.previewBound = "true";

      input.addEventListener("change", function(event) {
        var file = event.target.files && event.target.files[0];
        if (!file) return;

        var reader = new FileReader();
        reader.onload = function(loadEvent) {
          preview.src = loadEvent.target.result;
          preview.classList.remove("hidden");
          if (fallback) fallback.classList.add("hidden");
        };
        reader.readAsDataURL(file);
      });
    }

    document.addEventListener("DOMContentLoaded", initAvatarPreview);
    document.addEventListener("turbo:load", initAvatarPreview);
  })();
</script>
