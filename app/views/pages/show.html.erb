<% content_for :title, @page.title %>

<% case @page.template %>
<% when "contact" %>
  <section class="tom-page-hero">
    <div class="tom-container">
      <div class="tom-page-panel" data-reveal>
        <span class="tom-eyebrow" style="color:var(--tom-yellow);">Home / Contact</span>
        <h1>We'd love to hear from you</h1>
        <div style="margin-top:1rem;line-height:1.75;"><%= @page.body %></div>
      </div>
    </div>
  </section>

  <section class="tom-section bg-white">
    <div class="tom-container">
      <div class="tom-info-grid">
        <% [["Address", "Plot 85, Ladi Kwali Extension Layout, FCT, Abuja, Nigeria", "var(--tom-teal)"], ["Phone", "+234 803 086 9716", "var(--tom-orange)"], ["Email", "tommediang@gmail.com", "var(--tom-purple)"]].each do |label, value, accent| %>
          <div class="tom-resource-card" style="--accent:<%= accent %>;" data-reveal>
            <small>Contact</small>
            <h3><%= label %></h3>
            <p style="margin-top:.75rem;color:var(--tom-muted);line-height:1.55;"><%= value %></p>
          </div>
        <% end %>
      </div>

      <div class="tom-feature-split" style="align-items:start;margin-top:3rem;">
        <div class="tom-card" style="padding:1.5rem;" data-reveal>
          <h2>Send a Message</h2>
          <form style="display:grid;gap:1rem;margin-top:1.3rem;">
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;">
              <input class="tom-input" type="text" placeholder="Name" aria-label="Name">
              <input class="tom-input" type="email" placeholder="Email" aria-label="Email">
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;">
              <input class="tom-input" type="tel" placeholder="Phone" aria-label="Phone">
              <select class="tom-input" aria-label="Subject">
                <option>General enquiry</option>
                <option>Events</option>
                <option>Training</option>
                <option>Donation</option>
              </select>
            </div>
            <textarea class="tom-input" style="min-height:150px;" placeholder="Message" aria-label="Message"></textarea>
            <button type="submit" class="tom-btn tom-btn-primary" style="width:100%;border:0;">Send Message</button>
          </form>
        </div>

        <div style="display:grid;gap:1rem;">
          <div class="tom-card" style="overflow:hidden;" data-reveal>
            <iframe
              title="TOM Headquarters Map"
              src="https://www.google.com/maps?q=Kwali%2C%20Federal%20Capital%20Territory%2C%20Abuja%2C%20Nigeria&output=embed"
              style="width:100%;height:320px;border:0;"
              loading="lazy"></iframe>
          </div>
          <div class="tom-card" style="padding:1.25rem;" data-reveal>
            <h3>Office Hours</h3>
            <p style="margin-top:.75rem;color:var(--tom-muted);">Monday - Friday, 9:00 AM - 5:00 PM</p>
            <div style="display:flex;gap:.65rem;margin-top:1rem;">
              <% ["IG", "FB", "WA", "YT"].each do |label| %>
                <a href="#" class="tom-social" style="background:var(--tom-navy);" aria-label="<%= label %>"><%= label %></a>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<% when "privacy" %>
  <div class="bg-white" style="padding-top: 120px;">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 pb-24">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= @page.title %></h1>
      <p class="mt-4 text-sm text-gray-500">Last updated: <%= @page.updated_at.strftime("%B %d, %Y") %></p>

      <div class="mt-10 prose prose-lg prose-green max-w-none">
        <p>Your privacy is important to us. This policy explains how Teenagers' Outreach Ministries (TOM) Inc. collects, uses, and protects your personal information.</p>

        <h3>Information We Collect</h3>
        <p>We collect information you provide when registering for events, contacting us, or using ministry services. This may include your name, email address, and phone number.</p>

        <h3>How We Use Your Information</h3>
        <p>We use your information solely to provide our services, communicate with you about events and programmes, and improve our ministry outreach.</p>

        <h3>Data Protection</h3>
        <p>We are committed to ensuring that your information is secure and will not share your personal data with third parties without your consent.</p>

        <h3>Cookies</h3>
        <p>Our website may use cookies to enhance your browsing experience. You can choose to accept or decline cookies through your browser settings.</p>

        <h3>Contact Us</h3>
        <p>If you have any questions about this privacy policy, please contact us at <a href="mailto:info@tomint.org">info@tomint.org</a>.</p>

        <% if @page.body.present? %>
          <hr>
          <%= @page.body %>
        <% end %>
      </div>
    </div>
  </div>

<% when "terms" %>
  <div class="bg-white" style="padding-top: 120px;">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 pb-24">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= @page.title %></h1>
      <p class="mt-4 text-sm text-gray-500">Last updated: <%= @page.updated_at.strftime("%B %d, %Y") %></p>

      <div class="mt-10 prose prose-lg prose-green max-w-none">
        <p>By using the TOM International website and services, you agree to these terms and conditions.</p>

        <h3>Use of Service</h3>
        <p>This website is provided for informational purposes and to facilitate event registrations and ministry activities. Users are expected to provide accurate information when registering.</p>

        <h3>Account Responsibility</h3>
        <p>You are responsible for maintaining the confidentiality of your account credentials and all activities that occur under your account.</p>

        <h3>Event Registration</h3>
        <p>Registration for events is subject to availability. TOM reserves the right to cancel or modify events at any time, with notice provided to registered participants.</p>

        <h3>Intellectual Property</h3>
        <p>All content on this website, including text, images, and logos, is the property of Teenagers' Outreach Ministries (TOM) Inc. and is protected by applicable copyright laws.</p>

        <h3>Contact</h3>
        <p>If you have any questions about these terms, please contact us at <a href="mailto:info@tomint.org">info@tomint.org</a>.</p>

        <% if @page.body.present? %>
          <hr>
          <%= @page.body %>
        <% end %>
      </div>
    </div>
  </div>

<% else %>
  <div class="bg-white" style="padding-top: 120px;">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pb-24">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-8"><%= @page.title %></h1>
        <div class="prose prose-lg prose-green mx-auto">
          <%= @page.body %>
        </div>
      </div>
    </div>
  </div>
<% end %>

